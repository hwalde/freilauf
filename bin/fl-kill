#!/usr/bin/env bash
# Terminates a running coding-agent session (claude/opencode/hermes/cursor, with a
# safety prompt).
# Usage: fl-kill [options] [session-name]
set -euo pipefail

# The session tags and the reverse lookup live in one file, next to this one —
# they used to be a copy here and another one in fl-attach, and both had gone
# stale in the same place (cursor was missing from them).
FL_LIB="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/fl-harness-tags.sh"
if [[ ! -r "$FL_LIB" ]]; then
    printf '%s\n' "Error: $FL_LIB is missing — reinstall with setup/02-install-scripts.sh." >&2
    exit 1
fi
# shellcheck source=fl-harness-tags.sh
. "$FL_LIB"

PREFIX="$FL_PREFIX"

usage() {
    cat <<'EOF'
Usage: fl-kill [options] [session-name]

  session-name   Pick a session directly (with or without the fl-/fl-oc-/fl-he-/fl-cu-
                 prefix). If omitted: selection list (or directly, if only one is running).
                 Sessions from before the rename (cc-…) are listed and addressed too.

Options:
  -H, --harness HARNESS   Only show sessions of this harness:
                          claude | opencode | hermes | cursor
      --yes               Terminate without asking (for Freilauf; the confirmation
                          is handled by the UI there).
  -h, --help            Overview of all fl-* commands.
EOF
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && exec fl-help
[[ "${1:-}" == "--usage" ]] && { usage; exit 0; }

# Split off --yes (non-interactive) before the harness argument.
YES=""
ARGS=()
for a in "$@"; do
    case "$a" in
        --yes|-y) YES=1 ;;
        *) ARGS+=("$a") ;;
    esac
done
set -- "${ARGS[@]:-}"

err() { printf '%s\n' "$*" >&2; }

HARNESS=""
if [[ "${1:-}" == "-H" || "${1:-}" == "--harness" ]]; then
    HARNESS="${2:-}"
    if fl_harness_known "$HARNESS"; then
        shift 2
    else
        err "Error: unknown harness '$HARNESS'. Allowed: $(fl_harness_ids)"
        exit 2
    fi
fi

# Derive a session's harness from its name (fl-harness-tags.sh).
harness_of() { fl_harness_of "$1"; }

# A sandboxed run works in a container while its tmux session only holds the
# container client (SANDBOX_RESEARCH.md §7.1). Killing the session therefore
# kills the client and leaves the agent inside working with nobody watching, so
# the container is stopped FIRST — SIGTERM, then the runtime's own grace period,
# then SIGKILL.
#
# The session name ends in the run's short id (fl-start builds it as
# <prefix><tag><name>-<short id>, plus a -2 style suffix on a name collision) and
# the container is fl-<full run id>, so an anchored name filter is what connects
# the two. Everything here is fail-soft: no runtime on the PATH, no daemon, no
# container — fl-kill goes on and kills the session exactly as it always did.
CONTAINER_BIN="${FREILAUF_SANDBOX_RUNTIME_BIN:-docker}"

stop_container() {
    local s="$1" id names name
    command -v "$CONTAINER_BIN" >/dev/null 2>&1 || return 0
    id="$(printf '%s' "$s" | sed -nE 's/.*-([0-9a-fA-F]{8})(-[0-9]+)?$/\1/p')" || return 0
    [[ -n "$id" ]] || return 0
    names="$("$CONTAINER_BIN" ps --filter "name=^fl-${id}" --format '{{.Names}}' 2>/dev/null || true)"
    [[ -n "$names" ]] || return 0
    while IFS= read -r name; do
        [[ -n "$name" ]] || continue
        echo "  Stopping container '$name' …"
        "$CONTAINER_BIN" stop -t 30 "$name" >/dev/null 2>&1 || true
    done <<<"$names"
}

mapfile -t ROWS < <(tmux list-sessions \
    -F '#{session_name}|#{t:session_created}|#{?session_attached,attached,free}|#{session_path}' \
    2>/dev/null | grep -E "$(fl_session_re)" || true)

SESSIONS=()
for row in "${ROWS[@]}"; do
    s="${row%%|*}"
    [[ -n "$HARNESS" ]] && [[ "$(harness_of "$s")" != "$HARNESS" ]] && continue
    SESSIONS+=("$s")
done

if [[ ${#SESSIONS[@]} -eq 0 ]]; then
    if [[ -n "$HARNESS" ]]; then
        echo "No running $HARNESS session found."
    else
        echo "No running agent session found."
    fi
    exit 0
fi

kill_session() {
    local s="$1"
    local path attached
    attached="?"; path="?"
    for row in "${ROWS[@]}"; do
        IFS='|' read -r r_name _ r_attached r_path <<<"$row"
        if [[ "$r_name" == "$s" ]]; then
            attached="$r_attached"; path="$r_path"
        fi
    done

    echo
    echo "  Session:        $s  ($(harness_of "$s"))"
    echo "  Directory:      $path"
    echo "  Currently open: $attached"
    echo
    if [[ -n "$YES" ]]; then
        stop_container "$s"
        tmux kill-session -t "=$s"
        echo "Session '$s' terminated (--yes)."
        return
    fi
    echo "  WARNING: the running agent instance will be terminated; unsaved"
    echo "  work in this session will be lost."
    echo
    read -r -p "Really terminate session '$s'? Type the name to confirm: " confirm
    if [[ "$confirm" != "$s" ]]; then
        echo "Cancelled - name does not match."
        exit 0
    fi
    stop_container "$s"
    tmux kill-session -t "=$s"
    echo "Session '$s' terminated."
}

# Direct selection via argument (with or without prefix/harness tag)
if [[ -n "${1:-}" ]]; then
    TARGET="$1"
    for s in "${SESSIONS[@]}"; do
        bare="$(fl_harness_bare "$s")"    # remove the prefix and the harness tag
        treffer=""
        [[ "$s" == "$TARGET" || "$bare" == "$TARGET" ]] && treffer=1
        for p in "${FL_PREFIXES[@]}"; do [[ "$s" == "$p$TARGET" ]] && treffer=1; done
        if [[ -n "$treffer" ]]; then
            kill_session "$s"
            exit 0
        fi
    done
    err "Error: session '$TARGET' not found."
    exit 1
fi

echo "Running agent sessions:"
echo
i=1
for row in "${ROWS[@]}"; do
    IFS='|' read -r name created attached path <<<"$row"
    [[ -n "$HARNESS" ]] && [[ "$(harness_of "$name")" != "$HARNESS" ]] && continue
    printf "  [%d] %-24s  (%s)  started: %s  (%s)\n" "$i" "$name" "$(harness_of "$name")" "$created" "$attached"
    printf "      %s\n" "$path"
    i=$((i + 1))
done
echo

read -r -p "Which session to terminate? [1-$((i - 1)), q=cancel]: " choice
[[ "$choice" == "q" || -z "$choice" ]] && { echo "Cancelled."; exit 0; }

if ! [[ "$choice" =~ ^[0-9]+$ ]] || (( choice < 1 || choice > i - 1 )); then
    err "Invalid selection."
    exit 1
fi

kill_session "${SESSIONS[choice - 1]}"
