#!/usr/bin/env bash
# Terminates a running coding-agent session (claude/opencode/hermes, with a safety prompt).
# Usage: cc-kill [options] [session-name]
set -euo pipefail

PREFIX="cc-"

usage() {
    cat <<'EOF'
Usage: cc-kill [options] [session-name]

  session-name   Pick a session directly (with or without the cc-/cc-oc-/cc-he- prefix).
                 If omitted: selection list (or directly, if only one is running).

Options:
  -H, --harness HARNESS   Only show sessions of this harness: claude | opencode | hermes
      --yes               Terminate without asking (for cc-hub; the confirmation
                          is handled by the UI there).
  -h, --help            Overview of all cc commands.
EOF
}

[[ "${1:-}" == "-h" || "${1:-}" == "--help" ]] && exec cc-help
[[ "${1:-}" == "--usage" ]] && { usage; exit 0; }

# Split off --yes (non-interactive) before the harness argument.
YES=""
ARGS=()
for a in "$@"; do
    case "$a" in
        --yes|-y) YES=1 ;;
        *) ARGS+=("$a") ;;
    esac
done
set -- "${ARGS[@]:-}"

HARNESS=""
if [[ "${1:-}" == "-H" || "${1:-}" == "--harness" ]]; then
    HARNESS="${2:-}"
    case "$HARNESS" in
        claude|opencode|hermes) shift 2 ;;
        *) err() { printf '%s\n' "$*" >&2; }; err "Error: unknown harness '$HARNESS'. Allowed: claude opencode hermes"; exit 2 ;;
    esac
fi

err() { printf '%s\n' "$*" >&2; }

harness_of() {
    case "$1" in
        "$PREFIX"oc-*) echo "opencode" ;;
        "$PREFIX"he-*) echo "hermes" ;;
        *) echo "claude" ;;
    esac
}

mapfile -t ROWS < <(tmux list-sessions \
    -F '#{session_name}|#{t:session_created}|#{?session_attached,attached,free}|#{session_path}' \
    2>/dev/null | grep "^$PREFIX" || true)

SESSIONS=()
for row in "${ROWS[@]}"; do
    s="${row%%|*}"
    [[ -n "$HARNESS" ]] && [[ "$(harness_of "$s")" != "$HARNESS" ]] && continue
    SESSIONS+=("$s")
done

if [[ ${#SESSIONS[@]} -eq 0 ]]; then
    if [[ -n "$HARNESS" ]]; then
        echo "No running $HARNESS session found."
    else
        echo "No running agent session found."
    fi
    exit 0
fi

kill_session() {
    local s="$1"
    local path attached
    attached="?"; path="?"
    for row in "${ROWS[@]}"; do
        IFS='|' read -r r_name _ r_attached r_path <<<"$row"
        if [[ "$r_name" == "$s" ]]; then
            attached="$r_attached"; path="$r_path"
        fi
    done

    echo
    echo "  Session:        $s  ($(harness_of "$s"))"
    echo "  Directory:      $path"
    echo "  Currently open: $attached"
    echo
    if [[ -n "$YES" ]]; then
        tmux kill-session -t "=$s"
        echo "Session '$s' terminated (--yes)."
        return
    fi
    echo "  WARNING: the running agent instance will be terminated; unsaved"
    echo "  work in this session will be lost."
    echo
    read -r -p "Really terminate session '$s'? Type the name to confirm: " confirm
    if [[ "$confirm" != "$s" ]]; then
        echo "Cancelled - name does not match."
        exit 0
    fi
    tmux kill-session -t "=$s"
    echo "Session '$s' terminated."
}

# Direct selection via argument (with or without prefix/harness tag)
if [[ -n "${1:-}" ]]; then
    TARGET="$1"
    for s in "${SESSIONS[@]}"; do
        bare="${s#$PREFIX}"
        bare="${bare#oc-}"; bare="${bare#he-}"
        if [[ "$s" == "$TARGET" || "$s" == "$PREFIX$TARGET" || "$bare" == "$TARGET" ]]; then
            kill_session "$s"
            exit 0
        fi
    done
    err "Error: session '$TARGET' not found."
    exit 1
fi

echo "Running agent sessions:"
echo
i=1
for row in "${ROWS[@]}"; do
    IFS='|' read -r name created attached path <<<"$row"
    [[ -n "$HARNESS" ]] && [[ "$(harness_of "$name")" != "$HARNESS" ]] && continue
    printf "  [%d] %-24s  (%s)  started: %s  (%s)\n" "$i" "$name" "$(harness_of "$name")" "$created" "$attached"
    printf "      %s\n" "$path"
    i=$((i + 1))
done
echo

read -r -p "Which session to terminate? [1-$((i - 1)), q=cancel]: " choice
[[ "$choice" == "q" || -z "$choice" ]] && { echo "Cancelled."; exit 0; }

if ! [[ "$choice" =~ ^[0-9]+$ ]] || (( choice < 1 || choice > i - 1 )); then
    err "Invalid selection."
    exit 1
fi

kill_session "${SESSIONS[choice - 1]}"
