#!/usr/bin/env bash
# Starts a coding-agent session inside a tmux session (survives SSH logout).
# Harnesses: claude (default) | opencode | hermes.
#   Any OTHER coding agent is launched from a declaration handed in with --spec
#   (see "Launch spec" below) — that is how a cc-hub plugin nobody shipped here
#   still gets a tmux session.
#   claude:   interactive in bypassPermissions mode; autonomous (-p) in dontAsk mode.
#   opencode: interactive with --auto; autonomous (-p) as 'opencode --auto --prompt' (TUI,
#             works through the task on its own while staying operable).
#   hermes:   interactive with --yolo; autonomous (-p) as 'hermes chat -q --yolo'.
#   cursor:   cursor-agent with --force --trust; autonomous as a positional prompt (TUI,
#             works through the task and then stays open -- like opencode).
# Usage: cc-start [options] [session-name] [working-directory]
set -euo pipefail

PREFIX="cc-"
USAGE_SH="$HOME/.claude/usage.sh"

usage() {
    cat <<'EOF'
Usage: cc-start [options] [session-name] [working-directory]

  session-name   Name of the session (default: name of the working directory)
  directory      Working directory for the agent (default: current directory)

Choosing a harness (default: claude):
  -H, --harness HARNESS   claude | opencode | hermes | cursor — or the id of any
                          other coding agent, which then needs --spec.
      --effort LEVEL      Reasoning effort. '--effort' for claude, '--reasoning'
                          for hermes (same option, different name). NOT possible for
                          opencode: only 'opencode run' knows a --variant there, the
                          TUI does not; cc-hub sets it via OPENCODE_CONFIG_CONTENT
                          instead. NOT possible for cursor: there the level is already
                          part of the model ID (e.g. claude-opus-5-xhigh, -low, -max).
      --provider PROVIDER Inference provider, ONLY for hermes (e.g. deepseek, openrouter,
                          opencode-zen). With hermes the model is then bare or
                          author/slug; opencode picks the provider via the prefix
                          in the --model value instead.
      --model MODEL       Model. For claude an alias ('opus', 'fable', 'sonnet',
                          'haiku') or a full identifier ('claude-opus-5').
                          For opencode/hermes e.g. openrouter/stealth/ox-alpha
                          (format provider/model). If omitted:
                            opencode  -> uses the most recently used model
                                         (opencode remembers the last model; without
                                         --model and without "model" in the config the
                                         "recent" model from ~/.local/share/opencode/state
                                         is used, otherwise the config default)
                            hermes    -> uses the model configured in ~/.hermes/config.yaml
                                         (or the last hermes chat --model)
                            cursor    -> uses the model most recently selected in
                                         ~/.cursor/cli-config.json
                          For cursor a flat ID from 'cursor-agent models', with the
                          reasoning effort already baked in (claude-opus-5-xhigh). IDs
                          ending in '-fast' are the fast mode.

Options:
  -p, --prompt TEXT     Start prompt. The session then runs AUTONOMOUSLY and detaches
                        into the background (claude: dontAsk, opencode: TUI --auto --prompt, hermes: chat -q --yolo).
  -f, --prompt-file FILE Read the start prompt from a file (instead of -p).
      --mode MODE       Permission mode, ONLY for claude. Allowed:
                        dontAsk | bypassPermissions | acceptEdits | auto | manual | plan
                        Default: dontAsk with a prompt, bypassPermissions without.
  -a, --attach          Attach immediately even on an autonomous start (watch).
      --no-trust        Do NOT pre-confirm the trust dialog (claude only).
      --dry-run         Only show what would be started. Start nothing.
      --- cc-hub integration (Planung §9) ---
      --env KEY=VAL     Environment variable for the session (repeatable,
                        passed through as tmux new-session -e).
      --log FILE        Record a full transcript of the session from the start
                        (tmux pipe-pane into FILE).
      --keep            Keep the session open after the process ends (remain-on-exit)
                        + pane-died hook (cc-report _pane_died).
      --spec FILE       Launch declaration (JSON) of a coding agent this script
                        ships no case for. Required for any -H other than
                        claude/opencode/hermes/cursor, ignored for those four.
                        Needs jq. Format: see "Launch spec" below.
      --name NAME       Session base name without prefix (overrides the positional argument).
      --id SHORT        Suffix for the session name (collision safety,
                        e.g. a short run ID).
      --session-id UUID claude only: pass a fixed Claude session ID through
                        (--session-id, makes the transcript addressable in advance).
      --settings JSON   claude only: pass --settings JSON through (e.g. run hooks).
  -h, --help            This help.

Examples:
  cc-start                                  # claude interactive, current directory
  cc-start -H opencode video ~/projects/example  # opencode interactive (--auto)
  cc-start -H opencode --model openrouter/stealth/ox-alpha video ~/projects/example
  cc-start -H opencode -p "Get the tests green" build ~/projects/example
                                            # opencode autonomous, no model choice
  cc-start -H hermes -p "Analyze the logs" logs ~/projects/example
  cc-start -f ~/task.md nightrun ~/projects/example   # claude autonomous

Session names: cc-<name> (claude), cc-oc-<name> (opencode), cc-he-<name> (hermes),
               cc-cu-<name> (cursor), cc-<sessionTag><name> for a --spec harness.
View/select: cc-attach [-H harness], terminate: cc-kill, overview: cc-help

Launch spec (--spec FILE) — one JSON object describing how to call the CLI:
  {
    "bin":         "myagent",        REQUIRED. Looked up with 'command -v'.
    "sessionTag":  "my-",            tmux prefix: cc-<sessionTag><name>. Default "".
    "installHint": "npm i -g …",     printed when the binary is missing.
    "promptMode":  "argv",           argv | stdin | file  — how the prompt arrives.
    "args":        [ … ],            REQUIRED. Argument template, autonomous start.
    "interactiveArgs": [ … ],        optional; default: "args" without the prompt.
    "stderrLog":   "<path>",         optional; stderr is appended there (2>>).
    "submitNudge": { "waitFor": "ctrl+p", "timeoutSec": 90 }
  }
  An entry of "args" is either a string or a conditional group
  { "when": "model", "unless": "provider", "args": [ … ] } — "when"/"unless" name
  one of model | provider | effort | prompt | session_id | settings and ask
  whether it is set. Placeholders inside a string: {model} {provider} {effort}
  {session_id} {settings} {mode} {workdir} {session} {prompt_file} {stderr_log}
  {home}. "{prompt}" must be a WHOLE argument, never part of one.
  A non-empty "sessionTag" is noted in ~/.local/share/cc-hub/harness-tags
  (override: CCHUB_HARNESS_TAGS) so cc-attach and cc-kill can name the coding
  agent behind such a session instead of calling it claude.
  promptMode: argv -> the {prompt} argument carries the text; stdin -> the prompt
  is fed in on standard input; file -> use {prompt_file}, the file survives the
  start. An option whose placeholder the spec never mentions is REFUSED rather
  than passed through with no effect (same rule as --effort for cursor).

Notes per harness:
  claude:   dontAsk NEVER asks. Allowed things run, risky things are REFUSED (never hangs).
            Needs the permissions.allow list in ~/.claude/settings.json.
  opencode: --auto approves everything not explicitly denied in "permission"
            (config: ~/.config/opencode/opencode.json). No trust dialog; a one-time
            'opencode auth login' (e.g. openrouter) is required.
  hermes:   --yolo = auto-approve. One-time 'hermes setup' (provider) required. Global
            instructions: ~/.hermes/AGENTS.md (loaded via the SOUL.md pointer).
  cursor:   --force = Run Everything, --trust pre-confirms the workspace dialog
            (without it the TUI hangs there). One-time 'cursor-agent login'.
            CAUTION: cursor also reads CLAUDE.md, .claude/skills and .claude/agents
            (verified by measurement) — a run therefore sees more than just the prompt.
            The TUI STAYS OPEN after the work is done, so the pane never dies.
            cc-hub therefore puts a '.cursor/hooks.json' into the workspace whose
            'stop' hook calls cc-report; started by hand there is no run to report
            to and the session simply stays standing until cc-kill.
EOF
}

err() { printf '%s\n' "$*" >&2; }

# Shell-safe quoting for the generated launcher.
q() { printf "'%s'" "${1//\'/\'\\\'\'}"; }

PROMPT=""
PROMPT_FILE=""
MODE=""
ATTACH=""
DRY_RUN=""
NO_TRUST=""
HARNESS="claude"
MODEL=""
PROVIDER=""
EFFORT=""
ENVS=()
LOGFILE=""
KEEP=""
CLAUDE_SESSION_ID=""
CLAUDE_SETTINGS=""
NAME_ARG=""
ID_SUFFIX=""
SPEC=""
POS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)        usage; exit 0 ;;
        -H|--harness)     [[ $# -ge 2 ]] || { err "Error: $1 requires a value."; exit 2; }
                          HARNESS="$2"; shift 2 ;;
        --model)          [[ $# -ge 2 ]] || { err "Error: $1 requires a value."; exit 2; }
                          MODEL="$2"; shift 2 ;;
        --provider)       [[ $# -ge 2 ]] || { err "Error: $1 requires a value."; exit 2; }
                          PROVIDER="$2"; shift 2 ;;
        --effort)         [[ $# -ge 2 ]] || { err "Error: $1 requires a value."; exit 2; }
                          EFFORT="$2"; shift 2 ;;
        -p|--prompt)      [[ $# -ge 2 ]] || { err "Error: $1 requires a text."; exit 2; }
                          PROMPT="$2"; shift 2 ;;
        -f|--prompt-file) [[ $# -ge 2 ]] || { err "Error: $1 requires a file path."; exit 2; }
                          PROMPT_FILE="$2"; shift 2 ;;
        --mode)           [[ $# -ge 2 ]] || { err "Error: $1 requires a value."; exit 2; }
                          MODE="$2"; shift 2 ;;
        -a|--attach)      ATTACH=1; shift ;;
        --no-trust)       NO_TRUST=1; shift ;;
        --dry-run)        DRY_RUN=1; shift ;;
        --env)            [[ $# -ge 2 ]] || { err "Error: $1 requires KEY=VALUE."; exit 2; }
                          ENVS+=("$2"); shift 2 ;;
        --log)            [[ $# -ge 2 ]] || { err "Error: $1 requires a file."; exit 2; }
                          LOGFILE="$2"; shift 2 ;;
        --keep)           KEEP=1; shift ;;
        --session-id)     [[ $# -ge 2 ]] || { err "Error: $1 requires a UUID."; exit 2; }
                          CLAUDE_SESSION_ID="$2"; shift 2 ;;
        --settings)       [[ $# -ge 2 ]] || { err "Error: $1 requires JSON."; exit 2; }
                          CLAUDE_SETTINGS="$2"; shift 2 ;;
        --spec)           [[ $# -ge 2 ]] || { err "Error: $1 requires a file path."; exit 2; }
                          SPEC="$2"; shift 2 ;;
        --name)           [[ $# -ge 2 ]] || { err "Error: $1 requires a name."; exit 2; }
                          NAME_ARG="$2"; shift 2 ;;
        --id)             [[ $# -ge 2 ]] || { err "Error: $1 requires a short ID."; exit 2; }
                          ID_SUFFIX="$2"; shift 2 ;;
        --)               shift; POS+=("$@"); break ;;
        -*)               err "Unknown option: $1  (cc-start --help)"; exit 2 ;;
        *)                POS+=("$1"); shift ;;
    esac
done

# --- Launch spec (--spec) --------------------------------------------------
# Everything this script knows about claude/opencode/hermes/cursor is spelled
# out in a 'case' per harness below. A coding agent that arrived as a cc-hub
# plugin has no case here and never will — so it brings its own description
# instead, and the hub hands it over as a JSON file. Read once, up front, so the
# allowlist right after this can tell "unknown harness" from "harness we were
# told about".
SPEC_MODE=""            # set when THIS run is launched from the spec
SPEC_JSON=""
SPEC_BIN=""
SPEC_TAG=""
SPEC_INSTALL_HINT=""
SPEC_PROMPT_MODE="argv"
SPEC_ERRLOG=""
SPEC_ARGS_KEY="args"
if [[ -n "$SPEC" ]]; then
    [[ -r "$SPEC" ]] || { err "Error: launch spec not readable: $SPEC"; exit 2; }
    # jq is otherwise optional in this script (the trust flag degrades without
    # it). Here it is not: a launch declaration is JSON, and guessing at it with
    # sed would be a quoting bug waiting to start the wrong command.
    command -v jq >/dev/null 2>&1 || {
        err "Error: --spec needs jq (apt install jq / brew install jq)."; exit 2; }
    SPEC_JSON="$(cat "$SPEC")"
    jq -e 'type == "object"' >/dev/null 2>&1 <<<"$SPEC_JSON" || {
        err "Error: launch spec is not a JSON object: $SPEC"; exit 2; }
fi

case "$HARNESS" in
    claude|opencode|hermes|cursor) ;;
    *) if [[ -z "$SPEC_JSON" ]]; then
           err "Error: unknown harness '$HARNESS'. Built in: claude opencode hermes cursor"
           err "Any other coding agent is launched from its own declaration:"
           err "  cc-start --spec <launch.json> -H $HARNESS ..."
           exit 2
       fi
       SPEC_MODE=1 ;;
esac

if [[ -n "$SPEC_JSON" && -z "$SPEC_MODE" ]]; then
    # Not an error: the hub may hand the file over unconditionally. But the four
    # built-in command lines are the ones this script spells out itself, and
    # silently launching them from somewhere else would make two sources of
    # truth out of one.
    err "Note: --spec is ignored for the built-in coding agent '$HARNESS'."
fi

# Read a value out of the spec; empty when it is not there.
spec_str() { jq -r "$1 // empty" <<<"$SPEC_JSON" 2>/dev/null || true; }

# Does the spec mention this placeholder anywhere in its argument templates?
# That is the whole capability check: an option whose value would never reach
# the command line is refused instead of being silently swallowed — the same
# rule --effort for cursor has followed all along.
spec_uses() {
    spec_tokens | grep -Fq -- "{$1}"
}

# Every string in 'args' + 'interactiveArgs', groups flattened, one per line.
spec_tokens() {
    jq -r '[(.args // []), (.interactiveArgs // [])] | add
           | map(if type == "object" then (.args // []) else [.] end) | add // []
           | map(tostring) | .[]' <<<"$SPEC_JSON" 2>/dev/null || true
}

if [[ -n "$SPEC_MODE" ]]; then
    SPEC_BIN="$(spec_str '.bin')"
    [[ -n "$SPEC_BIN" ]] || { err "Error: launch spec has no \"bin\": $SPEC"; exit 2; }
    jq -e '(.args | type) == "array" and (.args | length) > 0' >/dev/null 2>&1 <<<"$SPEC_JSON" || {
        err "Error: launch spec has no non-empty \"args\" array: $SPEC"; exit 2; }
    # The session tag becomes part of a tmux session name, so it is held to the
    # same characters the name itself is.
    SPEC_TAG="$(spec_str '.sessionTag' | tr -cd 'A-Za-z0-9_-')"
    SPEC_INSTALL_HINT="$(spec_str '.installHint')"
    SPEC_PROMPT_MODE="$(spec_str '.promptMode')"
    [[ -n "$SPEC_PROMPT_MODE" ]] || SPEC_PROMPT_MODE="argv"
    case "$SPEC_PROMPT_MODE" in
        argv|stdin|file) ;;
        *) err "Error: launch spec has an unknown \"promptMode\" '$SPEC_PROMPT_MODE' (argv|stdin|file)."; exit 2 ;;
    esac
    jq -e 'has("interactiveArgs")' >/dev/null 2>&1 <<<"$SPEC_JSON" && SPEC_ARGS_KEY="interactiveArgs"

    # Note the tag down for cc-attach and cc-kill. Those two read tmux, not the
    # hub's database, so this start is the only moment on this machine where
    # anybody knows that 'cc-fa-' means 'fakeagent' — without it an external
    # coding agent's sessions would be listed as claude's, which is exactly the
    # bug cursor sat in for months. Append-once and fail-soft in every
    # direction: a session that starts is worth more than a tidy table.
    if [[ -z "$DRY_RUN" && -n "$SPEC_TAG" && "$HARNESS" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
        CC_TAGFILE="${CCHUB_HARNESS_TAGS:-${XDG_DATA_HOME:-$HOME/.local/share}/cc-hub/harness-tags}"
        if ! grep -qxF "$HARNESS:$SPEC_TAG" "$CC_TAGFILE" 2>/dev/null; then
            mkdir -p "$(dirname "$CC_TAGFILE")" 2>/dev/null || true
            printf '%s:%s\n' "$HARNESS" "$SPEC_TAG" >> "$CC_TAGFILE" 2>/dev/null || true
        fi
    fi

    # The per-harness flag rules, asked of the declaration instead of hard-coded.
    for opt in model provider effort; do
        val=""
        case "$opt" in
            model)    val="$MODEL" ;;
            provider) val="$PROVIDER" ;;
            effort)   val="$EFFORT" ;;
        esac
        if [[ -n "$val" ]] && ! spec_uses "$opt"; then
            err "Error: --$opt does not exist for '$HARNESS' (its launch spec never uses {$opt})."
            exit 2
        fi
    done
    if [[ -n "$CLAUDE_SESSION_ID" ]] && ! spec_uses session_id; then
        err "Note: --session-id has no place in '$HARNESS''s launch spec (ignored)."
    fi
    if [[ -n "$CLAUDE_SETTINGS" ]] && ! spec_uses settings; then
        err "Note: --settings has no place in '$HARNESS''s launch spec (ignored)."
    fi
fi

if [[ -n "$EFFORT" && "$HARNESS" == "cursor" ]]; then
    # Passing it through with no effect would be worse than an error: cursor-agent has
    # no --effort at all. The level is part of the model ID ('claude-opus-5-xhigh'),
    # and cursor loudly rejects an unknown model -- so a made-up ID must never come
    # into existence here in the first place.
    err "Error: --effort does not exist for cursor (the level is part of the model ID)."
    exit 2
fi

if [[ -n "$EFFORT" && "$HARNESS" == "opencode" ]]; then
    # Passing it through with no effect would be worse than an error: opencode only
    # knows --variant for 'opencode run', and here the TUI runs. The way there is
    # agent.<default>.variant in OPENCODE_CONFIG_CONTENT — cc-hub sets that itself.
    err "Error: --effort does not exist for opencode (set via OPENCODE_CONFIG_CONTENT there)."
    exit 2
fi

# The three rules above are about the four harnesses this script spells out; a
# --spec harness was already asked the same questions of its own declaration.
if [[ -z "$SPEC_MODE" ]] && [[ -n "$PROVIDER" && "$HARNESS" != "hermes" ]]; then
    # Only hermes has its own --provider. opencode decides via the prefix in the model
    # name, claude not at all — passing it through would be silently ineffective.
    err "Error: --provider only exists for hermes (for opencode the provider is part of the --model prefix)."
    exit 2
fi


if [[ -z "$SPEC_MODE" ]] && [[ -n "$CLAUDE_SESSION_ID" || -n "$CLAUDE_SETTINGS" ]] && [[ "$HARNESS" != "claude" ]]; then
    err "Note: --session-id/--settings only take effect with claude (ignored)."
fi

if [[ -n "$PROMPT_FILE" ]]; then
    [[ -n "$PROMPT" ]] && { err "Error: -p and -f are mutually exclusive."; exit 2; }
    [[ -r "$PROMPT_FILE" ]] || { err "Error: prompt file not readable: $PROMPT_FILE"; exit 2; }
    PROMPT="$(cat "$PROMPT_FILE")"
    [[ -n "${PROMPT//[[:space:]]/}" ]] || { err "Error: prompt file is empty: $PROMPT_FILE"; exit 2; }
fi

AUTONOM=""
[[ -n "$PROMPT" ]] && AUTONOM=1

# Locate the harness binary.
BIN=""
case "$HARNESS" in
    claude)  BIN="$(command -v claude || true)" ;;
    opencode) BIN="$(command -v opencode || true)" ;;
    hermes)  BIN="$(command -v hermes || true)" ;;
    cursor)  BIN="$(command -v cursor-agent || true)" ;;
esac
# A --spec harness names its own executable.
if [[ -z "$BIN" && -n "$SPEC_MODE" ]]; then
    BIN="$(command -v "$SPEC_BIN" || true)"
fi
if [[ -z "$BIN" ]]; then
    err "Error: '$HARNESS' not found in PATH."
    case "$HARNESS" in
        claude)  err "Installation: native Claude Code installation (claude in ~/.local/bin)." ;;
        opencode) err "Installation: npm install -g opencode-ai   (or: curl -fsSL https://opencode.ai/install | bash)" ;;
        hermes)  err "Installation: curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash" ;;
        cursor)  err "Installation: curl https://cursor.com/install -fsS | bash   (then: cursor-agent login)" ;;
    esac
    if [[ -n "$SPEC_MODE" ]]; then
        err "Missing binary: $SPEC_BIN"
        [[ -n "$SPEC_INSTALL_HINT" ]] && err "Installation: $SPEC_INSTALL_HINT"
    fi
    exit 1
fi

# Determine the mode (claude only). Without a prompt: bypassPermissions; with one: dontAsk.
if [[ -z "$MODE" ]]; then
    MODE=$([[ -n "$AUTONOM" ]] && echo "dontAsk" || echo "bypassPermissions")
fi
if [[ "$HARNESS" == "claude" ]]; then
    case "$MODE" in
        dontAsk|bypassPermissions|acceptEdits|auto|manual|plan) ;;
        *) err "Error: unknown mode '$MODE'."
           err "Allowed: dontAsk bypassPermissions acceptEdits auto manual plan"; exit 2 ;;
    esac
elif [[ "$MODE" != "dontAsk" && "$MODE" != "bypassPermissions" ]]; then
    # For opencode/hermes --mode is meaningless; only accept the default state.
    err "Note: --mode is ignored for $HARNESS ($HARNESS never asks: --auto or --yolo)."
fi

# Positional arguments: [session-name] [working-directory]. If the name is already set
# via --name (that is how cc-hub calls this), the directory moves up to position 1 —
# otherwise the agent would start in the CALLER's working directory instead of the worktree.
if [[ -n "$NAME_ARG" ]]; then
    WORKDIR="${POS[0]:-$PWD}"
else
    WORKDIR="${POS[1]:-$PWD}"
fi
[[ -d "$WORKDIR" ]] || { err "Error: directory '$WORKDIR' does not exist."; exit 1; }
WORKDIR="$(cd "$WORKDIR" && pwd)"

# Build the session name: cc-<name> (claude), cc-oc-<name> (opencode), cc-he-<name> (hermes).
HTAG=""
case "$HARNESS" in
    opencode) HTAG="oc-" ;;
    hermes)   HTAG="he-" ;;
    cursor)   HTAG="cu-" ;;
esac
# A --spec harness brings its own tag, so its sessions are as recognizable as
# cc-oc-/cc-he-/cc-cu- are. An empty tag is legal: it then looks like claude's.
[[ -n "$SPEC_MODE" ]] && HTAG="$SPEC_TAG"
RAW_NAME="${NAME_ARG:-${POS[0]:-$(basename "$WORKDIR")}}"
BASE_NAME="$PREFIX$HTAG$(printf '%s' "$RAW_NAME" | tr -c 'A-Za-z0-9_-' '-' | sed 's/-\+/-/g; s/^-//; s/-$//')"
[[ -n "$ID_SUFFIX" ]] && BASE_NAME="${BASE_NAME}-$(printf '%s' "$ID_SUFFIX" | tr -c 'A-Za-z0-9_-' '-' | sed 's/-\+/-/g; s/^-//; s/-$//')"
[[ "$BASE_NAME" == "$PREFIX$HTAG" ]] && BASE_NAME="${PREFIX}${HTAG}${HARNESS}"

# Add a number on name collision
SESSION="$BASE_NAME"
n=2
while tmux has-session -t "=$SESSION" 2>/dev/null; do
    SESSION="$BASE_NAME-$n"
    n=$((n + 1))
done

# Build the command line (without the prompt). Every harness spells --model out
# for itself in cmd_interactive()/cmd_autonomous() below — a shared argument
# array would not fit, because the flag sits in a different place per harness.

# opencode writes schema warnings from the MCP servers ("unknown format ... ignored")
# to stderr — right into the TUI, which wrecks the display. stderr therefore goes to
# a log file; real errors end up there and the TUI stays clean.
OC_ERRLOG="$HOME/.local/share/opencode/log/cc-$SESSION-stderr.log"
mkdir -p "$(dirname "$OC_ERRLOG")" 2>/dev/null || true

# Where the prompt and the mini launcher are dropped for an autonomous start.
# Computed HERE rather than down in that branch because the spec's
# {prompt_file} placeholder has to resolve for '--dry-run' too — the values
# depend on nothing but the session name and this process.
TDIR="${TMPDIR:-/tmp}"
PF="$TDIR/cc-prompt-$SESSION-$$.txt"
LF="$TDIR/cc-launch-$SESSION-$$.sh"

# --- The --spec command line ------------------------------------------------
# The same job the four cmd_interactive()/cmd_autonomous() cases do, only read
# out of the declaration instead of written down here. jq resolves the
# conditional groups and the placeholders; the quoting stays in bash, with the
# same q() the built-in cases use, so a model name with a space cannot become
# two arguments.
if [[ -n "$SPEC_MODE" ]]; then
    SPEC_ERRLOG="$(spec_str '.stderrLog' \
        | sed -e "s|{home}|$HOME|g" -e "s|{session}|$SESSION|g")"
    [[ -n "$SPEC_ERRLOG" ]] && mkdir -p "$(dirname "$SPEC_ERRLOG")" 2>/dev/null || true
fi

# Emit the resolved argument list, one base64 line per argument. base64 because
# an argument may contain anything at all — a newline in a --settings JSON would
# otherwise split it in two.
spec_argv() {
    local key="$1" have_prompt=""
    [[ -n "$AUTONOM" ]] && have_prompt=1
    jq -r --arg key "$key" --arg model "$MODEL" --arg provider "$PROVIDER" \
          --arg effort "$EFFORT" --arg prompt "$have_prompt" --arg mode "$MODE" \
          --arg session_id "$CLAUDE_SESSION_ID" --arg settings "$CLAUDE_SETTINGS" \
          --arg workdir "$WORKDIR" --arg session "$SESSION" --arg prompt_file "$PF" \
          --arg stderr_log "$SPEC_ERRLOG" --arg home "$HOME" '
        { model: $model, provider: $provider, effort: $effort, prompt: $prompt,
          session_id: $session_id, settings: $settings } as $set
        | def keep:
            (.when // null) as $w | (.unless // null) as $u
            | ((($w == null) or (($set[$w] // "") != ""))
               and (($u == null) or (($set[$u] // "") == "")));
          (.[$key] // [])
        | map(if type == "object" then (if keep then (.args // []) else [] end) else [.] end)
        | add // []
        | map(tostring
              | gsub("\\{model\\}"; $model) | gsub("\\{provider\\}"; $provider)
              | gsub("\\{effort\\}"; $effort) | gsub("\\{mode\\}"; $mode)
              | gsub("\\{session_id\\}"; $session_id) | gsub("\\{settings\\}"; $settings)
              | gsub("\\{workdir\\}"; $workdir) | gsub("\\{session\\}"; $session)
              | gsub("\\{prompt_file\\}"; $prompt_file) | gsub("\\{stderr_log\\}"; $stderr_log)
              | gsub("\\{home\\}"; $home))
        | .[] | @base64' <<<"$SPEC_JSON"
}

spec_cmd() {
    local key="$1" out="" el b64
    while IFS= read -r b64; do
        [[ -n "$b64" ]] || continue
        el="$(printf '%s' "$b64" | base64 -d)"
        if [[ "$el" == '{prompt}' ]]; then
            # Only in an autonomous start does the launcher hold the text; an
            # interactive one simply drops the argument.
            [[ -n "$AUTONOM" ]] && out+=' "$CC_PROMPT"'
        else
            out+=" $(q "$el")"
        fi
    done < <(spec_argv "$key")
    printf '%s%s' "$(q "$BIN")" "$out"
    [[ -n "$SPEC_ERRLOG" ]] && printf ' 2>>%s' "$(q "$SPEC_ERRLOG")"
    :
}

# The generic form of oc_submit_nudge(): wait for a string to appear on the
# pane, then press Enter once. A TUI that swallows a long --prompt needs it
# (measured for opencode; see there), and a declaration is the only way a
# harness this script has never heard of can ask for the same thing.
spec_submit_nudge() {
    local wait_for timeout
    jq -e '(.submitNudge | type) == "object"' >/dev/null 2>&1 <<<"$SPEC_JSON" || return 0
    wait_for="$(spec_str '.submitNudge.waitFor')"
    timeout="$(spec_str '.submitNudge.timeoutSec')"
    [[ "$timeout" =~ ^[0-9]+$ ]] || timeout=90
    printf '(\n'
    if [[ -n "$wait_for" ]]; then
        # Wait for the TUI to say it is there, not for a fixed number of seconds:
        # MCP servers can take a while, and an Enter before the editor exists
        # goes nowhere.
        printf '  i=0\n  while [[ $i -lt %s ]]; do\n' "$timeout"
        printf '      sleep 1\n'
        printf '      tmux capture-pane -p -t "$TMUX_PANE" 2>/dev/null | grep -qF -- %s && break\n' "$(q "$wait_for")"
        printf '      i=$((i + 1))\n  done\n'
    fi
    printf '  sleep 1\n'
    printf '  tmux send-keys -t "$TMUX_PANE" Enter 2>/dev/null\n) >/dev/null 2>&1 &\n'
}

cmd_interactive() {
    [[ -n "$SPEC_MODE" ]] && { spec_cmd "$SPEC_ARGS_KEY"; return 0; }
    case "$HARNESS" in
        claude)  printf '%s --permission-mode %s' "$(q "$BIN")" "$(q "$MODE")"
                 [[ -n "$MODEL" ]]  && printf ' --model %s' "$(q "$MODEL")"
                 [[ -n "$EFFORT" ]] && printf ' --effort %s' "$(q "$EFFORT")"
                 : ;;
        opencode) printf '%s --auto 2>>%s' "$(q "$BIN")" "$(q "$OC_ERRLOG")" ;;
        hermes)  printf '%s --yolo' "$(q "$BIN")" ;;
        cursor)  printf '%s --force --trust' "$(q "$BIN")"
                 [[ -n "$MODEL" ]] && printf ' --model %s' "$(q "$MODEL")"
                 : ;;
    esac
}

cmd_autonomous() {
    [[ -n "$SPEC_MODE" ]] && { spec_cmd args; return 0; }
    local model_args=""
    [[ -n "$MODEL" ]] && model_args=" --model $(q "$MODEL")"
    [[ -n "$PROVIDER" ]] && model_args+=" --provider $(q "$PROVIDER")"
    # hermes calls the same thing '--reasoning'.
    [[ -n "$EFFORT" && "$HARNESS" == "hermes" ]] && model_args+=" --reasoning $(q "$EFFORT")"
    local claude_args=""
    [[ "$HARNESS" == "claude" ]] && {
        [[ -n "$MODEL" ]]             && claude_args+=" --model $(q "$MODEL")"
        [[ -n "$EFFORT" ]]            && claude_args+=" --effort $(q "$EFFORT")"
        [[ -n "$CLAUDE_SESSION_ID" ]] && claude_args+=" --session-id $(q "$CLAUDE_SESSION_ID")"
        [[ -n "$CLAUDE_SETTINGS" ]]   && claude_args+=" --settings $(q "$CLAUDE_SETTINGS")"
    }
    case "$HARNESS" in
        claude)  printf '%s --permission-mode %s%s "$CC_PROMPT"' "$(q "$BIN")" "$(q "$MODE")" "$claude_args" ;;
        opencode) printf '%s --auto%s --prompt "$CC_PROMPT" 2>>%s' "$(q "$BIN")" "$model_args" "$(q "$OC_ERRLOG")" ;;
        hermes)  printf '%s chat -q "$CC_PROMPT" --yolo%s' "$(q "$BIN")" "$model_args" ;;
        # cursor: the prompt is a POSITIONAL argument, not -p. '-p/--print' would be
        # wrong here -- it prints and exits, the session would be gone immediately.
        # This way the TUI works through the task and then stays open (like opencode),
        # so it can be inspected and keeps a live pane for the watcher.
        # --trust is mandatory: without the flag the TUI hangs on the dialog
        # "Do you trust the contents of this directory?" (verified by measurement).
        cursor)  printf '%s --force --trust' "$(q "$BIN")"
                 [[ -n "$MODEL" ]] && printf ' --model %s' "$(q "$MODEL")"
                 printf ' -- "$CC_PROMPT"'
                 : ;;
    esac
}

# opencode only: press Enter once, after the TUI has drawn.
#
# 'opencode --prompt' puts the text into the TUI's editor and normally sends it
# off by itself -- but only up to a certain length. A real hub prompt (task plus
# platform rules plus extra skills) is past it: the text then sits UNSENT in the
# editor, opencode never starts working, and from the outside the run looks
# perfectly healthy -- tmux session alive, no error in the log. Measured with
# opencode 1.18.23: ~2 KB is sent off, ~20 KB is not.
#
# So the launcher nudges once. Enter on an EMPTY editor is a no-op in opencode
# (measured), so the case that sent itself by itself is not harmed: whichever of
# the two happens first sends the prompt, the other one hits an empty editor.
# The wait is for the status bar ('ctrl+p'), not a fixed number of seconds --
# MCP servers can take a while, and pressing Enter before the TUI is there would
# go nowhere.
oc_submit_nudge() {
    cat <<'NUDGE'
(
  i=0
  while [[ $i -lt 90 ]]; do
      sleep 1
      tmux capture-pane -p -t "$TMUX_PANE" 2>/dev/null | grep -q 'ctrl+p' && break
      i=$((i + 1))
  done
  sleep 1
  tmux send-keys -t "$TMUX_PANE" Enter 2>/dev/null
) >/dev/null 2>&1 &
NUDGE
}

# Quota notice (claude only: usage.sh is Claude-specific).
quota_hinweis() {
    [[ "$HARNESS" == "claude" ]] || return 0
    [[ -x "$USAGE_SH" ]] || return 0
    local json pct reset
    json="$("$USAGE_SH" 2>/dev/null | tail -1)" || return 0
    pct="$(printf '%s' "$json" | sed -n 's/.*"usage_pct"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p')"
    [[ -n "$pct" ]] || return 0
    reset="$(printf '%s' "$json" | sed -n 's/.*"reset_at"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
    if (( pct >= 90 )); then
        err "Quota warning: ${pct}% of the 5-hour window used (reset: ${reset:-unknown})."
        err "The session will probably pause immediately. Abort with Ctrl+C, otherwise it starts."
    else
        echo "Quota: ${pct}% of the 5-hour window used (reset: ${reset:-unknown})"
    fi
}

# Pre-confirm the trust dialog (claude only).
trust_workdir() {
    [[ "$HARNESS" == "claude" ]] || return 0
    local dir="$1" cfg="$HOME/.claude.json" cur tmp
    [[ -f "$cfg" ]] || return 0
    command -v jq >/dev/null 2>&1 || {
        err "Note: jq is missing — the trust dialog cannot be pre-confirmed."
        return 0
    }
    cur="$(jq -r --arg d "$dir" '.projects[$d].hasTrustDialogAccepted // false' "$cfg" 2>/dev/null || echo false)"
    [[ "$cur" == "true" ]] && return 0

    tmp="$(mktemp "${cfg}.cc.XXXXXX")" || return 0
    if jq --arg d "$dir" \
         '.projects = ((.projects // {}) | .[$d] = ((.[$d] // {}) + {hasTrustDialogAccepted: true}))' \
         "$cfg" > "$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
        chmod --reference="$cfg" "$tmp" 2>/dev/null || chmod 600 "$tmp"
        cp -p "$cfg" "$cfg.bak-cc-start" 2>/dev/null || true
        mv "$tmp" "$cfg"
        echo "Trust dialog pre-confirmed for $dir (~/.claude.json)."
    else
        rm -f "$tmp"
        err "Warning: could not set the trust flag. The session may stay stuck on the"
        err "'Do you trust this folder?' question — run 'cc-attach' once and press Enter."
    fi
}

# Auth/setup preflight checks (non-blocking, warning only).
preflight() {
    case "$HARNESS" in
        opencode)
            if ! "$BIN" auth list 2>/dev/null | grep -qE "[1-9][0-9]* credentials"; then
                err "Note: opencode has no credentials yet (opencode auth list)."
                err "One-time: opencode auth login   (e.g. openrouter) — or set OPENROUTER_API_KEY."
            fi
            ;;
        hermes)
            if [[ ! -f "$HOME/.hermes/config.yaml" ]]; then
                err "Note: ~/.hermes/config.yaml is missing — hermes is not set up yet."
                err "One-time: hermes setup   (choose a provider, e.g. openrouter)."
            fi
            ;;
        cursor)
            if ! "$BIN" status >/dev/null 2>&1; then
                err "Note: 'cursor-agent status' fails — probably not logged in."
                err "One-time: cursor-agent login"
            fi
            ;;
    esac
}

if [[ -n "$DRY_RUN" ]]; then
    echo "--- Would start ---"
    echo "Harness:        $HARNESS"
    echo "Binary:         $BIN"
    echo "Session:        $SESSION"
    echo "Directory:      $WORKDIR"
    echo "Autonomous:     $([[ -n "$AUTONOM" ]] && echo "yes (detaches into the background)" || echo "no (interactive, attaches)")"
    if [[ -n "$MODEL" ]]; then
        echo "Model:          $MODEL"
    else
        echo "Model:          (not set — $HARNESS uses its default/most recently used model)"
    fi
    if [[ -n "$EFFORT" ]]; then
        echo "Effort:         $EFFORT"
    fi
    if [[ -n "$PROVIDER" ]]; then
        echo "Provider:       $PROVIDER"
    fi
    if [[ "$HARNESS" == "claude" ]]; then
        echo "Mode:           $MODE"
        if [[ -n "$AUTONOM" && -z "$NO_TRUST" ]]; then
            echo "Trust flag:     $(jq -r --arg d "$WORKDIR" \
                'if (.projects[$d].hasTrustDialogAccepted // false) then "already set" else "would be set" end' \
                "$HOME/.claude.json" 2>/dev/null || echo "unknown")"
        fi
    elif [[ "$HARNESS" == "cursor" ]]; then
        echo "Mode:           auto-approve (--force) + workspace pre-trusted (--trust)"
    elif [[ -n "$SPEC_MODE" ]]; then
        echo "Spec:           $SPEC"
        echo "Prompt via:     $SPEC_PROMPT_MODE"
        [[ -n "$SPEC_ERRLOG" ]] && echo "stderr log:     $SPEC_ERRLOG"
        :
    else
        echo "Mode:           auto-approve (--auto or --yolo)"
    fi
    echo "Command:        $(if [[ -n "$AUTONOM" ]]; then cmd_autonomous | sed 's/\$CC_PROMPT/<prompt>/'; else cmd_interactive; fi)"
    [[ -n "$AUTONOM" ]] && { echo "--- Prompt ---"; printf '%s\n' "$PROMPT"; }
    echo "--- Quota (claude only) ---"
    quota_hinweis
    exit 0
fi

if [[ -n "$AUTONOM" ]]; then
    quota_hinweis
    [[ -z "$NO_TRUST" ]] && trust_workdir "$WORKDIR"
fi
preflight

# Size of the new session. tmux otherwise creates detached sessions in default-size
# (80x24); on a later attach from a larger terminal the pane gets rewrapped and
# already-drawn output falls apart. So create it at target size right away.
TMUX_W="$(tput cols 2>/dev/null || true)"
TMUX_H="$(tput lines 2>/dev/null || true)"
[[ "$TMUX_W" =~ ^[0-9]+$ ]] && (( TMUX_W >= 40 )) || TMUX_W=200
[[ "$TMUX_H" =~ ^[0-9]+$ ]] && (( TMUX_H >= 10 )) || TMUX_H=50

# --env KEY=VAL → tmux new-session -e (repeatable). Validation: KEY=VAL only.
ENV_ARGS=()
for kv in "${ENVS[@]:-}"; do
    [[ -n "$kv" ]] || continue
    [[ "$kv" == *=* ]] || { err "Error: --env requires KEY=VALUE, got: '$kv'"; exit 2; }
    ENV_ARGS+=("-e" "$kv")
done

if [[ -z "$AUTONOM" ]]; then
    # Interactive: start directly, no launcher needed.
    if (( ${#ENV_ARGS[@]} )); then
        tmux new-session -d -x "$TMUX_W" -y "$TMUX_H" "${ENV_ARGS[@]}" -s "$SESSION" -c "$WORKDIR" "$(cmd_interactive)"
    else
        tmux new-session -d -x "$TMUX_W" -y "$TMUX_H" -s "$SESSION" -c "$WORKDIR" "$(cmd_interactive)"
    fi
else
    # Autonomous: drop the prompt and a mini launcher as files. This sidesteps every
    # quoting trap when passing multi-line prompts through tmux. Both files delete
    # themselves at startup, right after being read (TDIR/PF/LF are set further
    # up, where the spec's {prompt_file} can already resolve).
    # Clean up leftovers of aborted starts (older than one day), fail-safe.
    find "$TDIR" -maxdepth 1 \( -name 'cc-prompt-*.txt' -o -name 'cc-launch-*.sh' \) \
        -mtime +1 -delete 2>/dev/null || true

    printf '%s' "$PROMPT" > "$PF"
    chmod 600 "$PF"
    {
        printf '#!/usr/bin/env bash\n'
        printf 'cd %s\n' "$(q "$WORKDIR")"
        printf 'CC_PROMPT="$(cat %s)"\n' "$(q "$PF")"
        if [[ -n "$SPEC_MODE" && "$SPEC_PROMPT_MODE" == "file" ]]; then
            # promptMode 'file': the CLI reads the prompt from that very path, so
            # only the launcher may delete itself. The sweep above collects the
            # prompt file a day later.
            printf 'rm -f %s\n' "$(q "$LF")"
        else
            printf 'rm -f %s %s\n' "$(q "$PF")" "$(q "$LF")"
        fi
        [[ "$HARNESS" == "opencode" ]] && oc_submit_nudge
        [[ -n "$SPEC_MODE" ]] && spec_submit_nudge
        if [[ -n "$SPEC_MODE" && "$SPEC_PROMPT_MODE" == "stdin" ]]; then
            # A here-string, not a pipe: the redirection is set up before exec, so
            # the CLI still becomes the pane's own process and pane-died keeps
            # meaning what it means everywhere else.
            printf 'exec %s <<< "$CC_PROMPT"\n' "$(cmd_autonomous)"
        else
            printf 'exec %s\n' "$(cmd_autonomous)"
        fi
    } > "$LF"
    chmod 700 "$LF"

    if (( ${#ENV_ARGS[@]} )); then
        tmux new-session -d -x "$TMUX_W" -y "$TMUX_H" "${ENV_ARGS[@]}" -s "$SESSION" -c "$WORKDIR" bash "$LF"
    else
        tmux new-session -d -x "$TMUX_W" -y "$TMUX_H" -s "$SESSION" -c "$WORKDIR" bash "$LF"
    fi
fi

# cc-hub integration: start the full transcript IMMEDIATELY after new-session (otherwise
# the beginning is missing), keep the session open after process end + report pane-died
# (Planung 7.2). An error HERE would be especially treacherous: the session is already
# running, but 'set -e' would abort cc-start — the caller would see a failed start while
# the session kept running orphaned. So clean up instead of leaving orphans behind.
tmux_or_die() {
    if ! tmux "$@" 2>&1; then
        err "Error: 'tmux $*' failed — terminating session '$SESSION' again."
        tmux kill-session -t "=$SESSION" 2>/dev/null || true
        exit 1
    fi
}

if [[ -n "$LOGFILE" ]]; then
    mkdir -p "$(dirname "$LOGFILE")" 2>/dev/null || true
    # Two traps in one line:
    #  - Target: "=name" is NOT a pane target for pipe-pane ("can't find pane"). The
    #    colon turns it into the session's active pane.
    #  - $LOGFILE ends up inside a shell command and must be quoted.
    tmux_or_die pipe-pane -o -t "=$SESSION:" "cat >> $(q "$LOGFILE")"
fi
if [[ -n "$KEEP" ]]; then
    tmux_or_die set-option -t "=$SESSION:" -q remain-on-exit on
    # set-hook likewise needs a target with ':' — "=name" alone: "no such window".
    tmux_or_die set-hook -t "=$SESSION:" pane-died 'run-shell "cc-report _pane_died #{pane_dead_status}"'
fi

tmux set-option -t "=$SESSION:" -q history-limit 50000
tmux set-option -t "=$SESSION:" -q mouse on
tmux set-window-option -t "=$SESSION:" -q aggressive-resize on

# tmux reports success even if the command dies right away. Let it run briefly and
# check whether the session is really alive.
sleep 1
if ! tmux has-session -t "=$SESSION" 2>/dev/null; then
    err "Error: session ended immediately — the start command is dying."
    err "Test directly: $(if [[ -n "$AUTONOM" ]]; then cmd_autonomous | sed 's/\$CC_PROMPT/<prompt>/'; else cmd_interactive; fi)"
    [[ -n "$AUTONOM" ]] && rm -f "$PF" "$LF" 2>/dev/null
    exit 1
fi

echo "Session '$SESSION' started in $WORKDIR (harness: $HARNESS)"

if [[ -n "$AUTONOM" && -z "$ATTACH" ]]; then
    echo "Running autonomously in the background. Watch:  cc-attach $SESSION"
    echo "Terminate:                                      cc-kill $SESSION"
    exit 0
fi

echo "Detach with: Ctrl+b, then d"
if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "=$SESSION"
else
    tmux attach-session -t "=$SESSION"
fi
