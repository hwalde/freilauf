#!/usr/bin/env bash
# fl-report — agents report back to Freilauf (Planung 6).
# Usage:
#   fl-report done [--file report.md [--detail report-detail.md] | "text"]
#                                                  Run completed — or, from a run that
#                                                  is already over, a FOLLOW-UP report:
#                                                  same command, the hub tells them apart.
#                                                  --detail hands the hub the DETAILED
#                                                  version: the text is the short report
#                                                  (what it was about + the result), the
#                                                  detail travels as the attached document.
#   fl-report failed "reason"                      Run failed
#   fl-report help "question/problem"              Call for help (run stays open, waits)
#   fl-report progress "status"                    Progress / taking longer
#   fl-report access "what you need and why"       Ask for something the sandbox blocks
#                                                  (a host, a directory, more memory).
#                                                  A human decides; keep working on
#                                                  whatever you CAN do meanwhile.
#   fl-report branch <name>                        Branch reported
#   fl-report pr <url>                             Pull request reported
#   fl-report _api_error [error] ["text"]         Rate-limit/provider error (from hooks);
#                                                  without arguments: Claude hook JSON on stdin
#   fl-report _turn_end|_exit|_rate_limit|_idle|_pane_died [exit]   internal hooks
#   fl-report _working [prompt|tool] | _waiting    the agent's attention (from hooks):
#                                                  it started processing input / its
#                                                  turn is over and it waits for a human.
#                                                  'prompt' = a human submitted a line;
#                                                  anything else is a tool call or a
#                                                  status the CLI reports by itself
#
# Source: FL_RUN_ID from the environment, and ONE of two channels to the hub —
# FL_HUB_SOCKET (a unix socket carrying only the report route, SANDBOX_RESEARCH.md
# §7.6) or FL_HUB_URL (the full API on 127.0.0.1). CC_RUN_ID/CC_HUB_URL are still
# accepted, for sessions started before the rename. FL_RUN_TOKEN, when set, is the
# run's own bearer and travels with both. Fallback when neither channel answers:
# a JSON line into <runs dir>/<id>/inbox.jsonl — the watcher collects it.
set -euo pipefail

usage() {
    sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'
}

[[ $# -ge 1 ]] || { usage >&2; exit 2; }
KIND="$1"; shift

case "$KIND" in
    done|failed|help|progress|branch|pr|access) ;;
    _turn_end|_exit|_rate_limit|_idle|_pane_died|_api_error|_working|_waiting) ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'unknown kind: %s\n' "$KIND" >&2; exit 2 ;;
esac

# The old names for one transition release. A session that started before the
# rename carries CC_RUN_ID/CC_HUB_URL and calls this script through the
# `cc-report` shim; its prompt, its claude hooks and its .cursor/hooks.json were
# all written then, and none of them can be rewritten from here.
RUN_ID="${FL_RUN_ID:-${CC_RUN_ID:-}}"
HUB="${FL_HUB_URL:-${CC_HUB_URL:-http://127.0.0.1:8791}}"
# The narrow channel (SANDBOX_RESEARCH.md §7.6) and the run's own bearer. Both
# are OPTIONAL and both may be absent: a run on an older hub, an unsandboxed run
# started before this release, a human trying the command by hand. Absent means
# "the way it always worked", and nothing below may depend on either being set.
SOCKET="${FL_HUB_SOCKET:-}"
TOKEN="${FL_RUN_TOKEN:-}"
if [[ -z "$RUN_ID" ]]; then
    echo "fl-report: FL_RUN_ID is not set — pointless outside a Freilauf run." >&2
    exit 3
fi

TEXT="" ; FILE_ARG="" ; DETAIL_ARG="" ; ERR="" ; SESSION_ID=""
# Claude calls the StopFailure hook without arguments and delivers the event as JSON
# on stdin: { "error": "rate_limit", "last_assistant_message": "…", "session_id": "…" }.
# The other hook kinds (Stop, SessionEnd, Notification) get the same JSON shape.
# session_id is forwarded so the hub can tell the run's OWN session from a claude
# process the agent spawned (which inherits hooks and FL_RUN_ID but carries its own
# session id) — its failures must not land on the run as incidents.
if [[ "$KIND" == "_api_error" || "$KIND" == "_turn_end" || "$KIND" == "_exit" || "$KIND" == "_idle" \
      || "$KIND" == "_working" || "$KIND" == "_waiting" ]]; then
    HOOK_JSON=""
    if [[ "$KIND" == "_api_error" ]]; then
        if [[ -n "${1:-}" ]]; then
            ERR="$1"; shift; TEXT="${*:-}"
        elif [[ ! -t 0 ]]; then
            # Bounded read — see the identical comment below; this is the original
            # _api_error path and it must not block either.
            HOOK_JSON="$(timeout 2 cat 2>/dev/null || true)"
        else
            ERR="unknown"
        fi
    elif [[ ! -t 0 ]]; then
        # BOUNDED read, and that is load-bearing. `[[ ! -t 0 ]]` only says stdin is
        # not a terminal — it does NOT say anybody is going to write to it or ever
        # close it. A real hook hands over its JSON and closes at once, so the
        # timeout costs nothing there; every OTHER caller that inherited an open
        # pipe (a script, a test, a hand-typed `fl-report _turn_end`) would
        # otherwise block forever. This used to apply to _api_error alone; the day
        # it was extended to _turn_end/_exit/_idle it became a hang on the events
        # that fire constantly — and _exit runs from SessionEnd, which claude waits for.
        HOOK_JSON="$(timeout 2 cat 2>/dev/null || true)"
    fi
    if [[ -n "$HOOK_JSON" ]]; then
        ERR="$(printf '%s' "$HOOK_JSON" | python3 -c 'import json,sys
try: j=json.load(sys.stdin); print(j.get("error") or "unknown")
except Exception: print("unknown")' 2>/dev/null || echo unknown)"
        TEXT="$(printf '%s' "$HOOK_JSON" | python3 -c 'import json,sys
try: j=json.load(sys.stdin); print((j.get("last_assistant_message") or j.get("error_details") or "")[:300])
except Exception: pass' 2>/dev/null || true)"
        SESSION_ID="$(printf '%s' "$HOOK_JSON" | python3 -c 'import json,sys
try: j=json.load(sys.stdin); print(j.get("session_id") or "")
except Exception: pass' 2>/dev/null || true)"
    fi
    if [[ "$KIND" == "_api_error" ]]; then set --; fi
fi
if [[ -n "${1:-}" ]]; then
    if [[ "$KIND" == "done" && "${1:-}" == "--file" ]]; then
        FILE_ARG="${2:-}"
        [[ -r "$FILE_ARG" ]] || { echo "Report file not readable: $FILE_ARG" >&2; exit 2; }
        # The detailed version is optional and only valid for `done`: `--detail`
        # always follows the `--file` it belongs to.
        if [[ "${3:-}" == "--detail" ]]; then
            DETAIL_ARG="${4:-}"
            [[ -r "$DETAIL_ARG" ]] || { echo "Detail report file not readable: $DETAIL_ARG" >&2; exit 2; }
        fi
    else
        TEXT="$*"
    fi
fi

# Build the payload as JSON with python3 (quoting-safe, no jq dependency).
PAYLOAD="$(python3 - "$KIND" "$TEXT" "$FILE_ARG" "$DETAIL_ARG" "$ERR" "$SESSION_ID" <<'PY'
# `os` is used below for os.path.isfile — it was lost once, and the failure is
# invisible until the ONE call that matters: `fl-report done --file <report>`
# dies with a NameError, so an agent finishes its work and cannot say so.
# `fl-report progress` keeps working, because an empty file argument
# short-circuits the isfile() call — which is exactly why it went unnoticed.
import json, os, sys
kind, text, file_arg, detail_arg, err, session_id = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5], sys.argv[6]
body = {"kind": kind}
if kind == "_api_error":
    body["error"] = err or "unknown"
    if text:
        body["text"] = text
elif kind == "_pane_died" and text.isdigit():
    body["exit"] = int(text)
elif kind == "branch":
    body["branch"] = text
elif kind == "pr":
    body["pr"] = text
elif kind in ("_working", "_waiting"):
    # The optional source word ('prompt' / 'tool' / whatever the hook says):
    # the hub reads 'prompt' as a human typing — a commission on a finished
    # run — and everything else as the CLI going about its turn (reports.mjs,
    # commissionOnWorking).
    if text:
        body["source"] = text.split()[0][:40]
else:
    if file_arg and os.path.isfile(file_arg):
        with open(file_arg, encoding="utf-8", errors="replace") as fh:
            body["file"] = fh.read()
        if detail_arg and os.path.isfile(detail_arg):
            with open(detail_arg, encoding="utf-8", errors="replace") as fh:
                body["detail"] = fh.read()
    elif text:
        body["text"] = text
if session_id:
    body["session_id"] = session_id
print(json.dumps(body))
PY
)"

# The bearer, as an argument list so an unset token adds no header at all. The
# `${AUTH[@]+…}` form is what keeps `set -u` happy on an empty array.
AUTH=()
[[ -n "$TOKEN" ]] && AUTH=(-H "authorization: Bearer $TOKEN")

# The socket carries ONLY the report route, so it is the channel a sandboxed run
# gets — the container cannot reach the host's loopback anyway, and an agent that
# could would have the hub's whole API in its hands. Tried first wherever it
# exists, because a hub that offers it is a hub that prefers it.
send_socket() {
    [[ -n "$SOCKET" && -S "$SOCKET" ]] || return 1
    curl -fsS --max-time 10 -X POST --unix-socket "$SOCKET" \
         -H 'content-type: application/json' ${AUTH[@]+"${AUTH[@]}"} \
         --data-binary "$PAYLOAD" \
         "http://hub/api/runs/$RUN_ID/report"
}

send_http() {
    curl -fsS --max-time 10 -X POST \
         -H 'content-type: application/json' ${AUTH[@]+"${AUTH[@]}"} \
         --data-binary "$PAYLOAD" \
         "$HUB/api/runs/$RUN_ID/report"
}

# Where the inbox lives. Deliberately NOT `$HOME/agents/runs` spelled out, which
# is what it was, and which was wrong in both directions that matter now: the
# runs directory is a seam (`FREILAUF_RUNS_DIR` — the test suite points it into
# its own sandbox, so the one channel a report has left was also the one channel
# the suite could never observe), and inside a container `$HOME` is the run's own
# seeded home (§7.7), where `agents/runs` does not exist at all — the last
# fallback a report has would have written into nowhere, silently.
#
# Same rule as every other `fl-*` script: `fl-paths.sh` answers it, and the old
# `CCHUB_` name is part of the answer. A copy of this script that lost its
# library still has to be able to report, hence the two names read directly.
FL_PATHS="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/fl-paths.sh"
# shellcheck source=fl-paths.sh
[[ -r "$FL_PATHS" ]] && . "$FL_PATHS"
if declare -F fl_env >/dev/null 2>&1; then
    RUNS_DIR="$(fl_env RUNS_DIR "$HOME/agents/runs")"
else
    RUNS_DIR="${FREILAUF_RUNS_DIR:-${CCHUB_RUNS_DIR:-$HOME/agents/runs}}"
fi
FALLBACK_DIR="$RUNS_DIR/$RUN_ID"
# Socket, then loopback, then the inbox. A hub that does not know a kind answers
# 400, which reads here as "not reachable" and files the line in the inbox — the
# watcher replays it once, gets the same refusal and drops it (watcher.mjs,
# collectInboxes). Harmless by design: a refused report never loops.
if OUT="$(send_socket 2>/dev/null)" || OUT="$(send_http 2>/dev/null)"; then
    # Freilauf may ANSWER a report instead of just accepting it: with the repo's
    # integration switched on, `done` is checked (worktree clean? branch still
    # mergeable?) and the answer says what is still missing. Printing it puts the
    # text into the agent's running turn as this tool's own output — the cheapest
    # possible moment to tell it. Silent otherwise, as before.
    printf '%s' "$OUT" | python3 -c 'import json,sys
try:
    j = json.load(sys.stdin)
    m = j.get("message")
    if m: print(m)
except Exception:
    pass' 2>/dev/null || true
    exit 0
fi

# Fallback: hub not reachable → inbox.jsonl (the watcher collects it, Planung 6).
mkdir -p "$FALLBACK_DIR" 2>/dev/null || true
printf '%s\n' "$PAYLOAD" >> "$FALLBACK_DIR/inbox.jsonl"
echo "fl-report: hub not reachable — the report is in inbox.jsonl, the watcher will pick it up." >&2
exit 0
