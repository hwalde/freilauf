#!/usr/bin/env node
// fl-panel — a project pushes its own numbers into Freilauf's status sidebar.
//
//   register/befund.py zaehl --json | fl-panel set findings --title Findings
//   fl-panel set tests --total 12 --item "failing=3:red" --item "skipped=9"
//   fl-panel error findings "the register tool is not on this branch"
//   fl-panel show                       what this repo currently shows
//   fl-panel clear findings
//
//   fl-panel set schwarm --total 1 --control "n=1:number:0..6" --control "go:button" \
//     --action-cwd /path/to/a/current/checkout -- ./tool throttle --n "{{n}}"
//   fl-panel get schwarm n              what that field is set to
//
// Why this exists: the sidebar can say how the MACHINE is doing (quota, work in
// flight, memory) and nothing at all about how the WORK is doing — how many
// findings are still open, how many tests fail. That question belongs to the
// project, and its counting rule has no business inside Freilauf. So the project
// counts and pushes; the hub stores and renders. And since a panel may also TAKE
// a value, the same seam runs the other way: the hub renders the fields the
// project declared and hands what was entered back to the project's own command
// — as argv, never through a shell. See docs/panels.md.
//
// Inside a run nothing has to be configured: `FL_RUN_ID` and `FL_HUB_URL` are
// already in the session, and the run knows its repository. Outside one, name
// the repo with `--repo <id|name>`.
//
// Node rather than bash on purpose: the payload IS JSON, and quoting a label an
// agent wrote through a shell is how a panel would silently lose its numbers.
//
// Exit codes: 0 = accepted, 1 = refused or unreachable, 2 = usage error.
import { readFileSync, existsSync } from 'node:fs'
import { homedir } from 'node:os'
import { join } from 'node:path'

const USAGE = `Usage:
  fl-panel set <key> [options]        push a value (JSON on stdin, or --item/--total)
  fl-panel error <key> <message>      say the measurement failed; the old numbers stay, greyed
  fl-panel clear <key>                remove the panel
  fl-panel show                       print this repo's panels
  fl-panel get <key> [<control>]      print what a control is set to (one per line without one)

Options for "set":
  --repo <id|name>   which repository (default: the repo of $FL_RUN_ID)
  --title <text>     the block's heading (default: the key)
  --total <n>        the headline number
  --tone <t>         red | yellow | green — colours the headline
  --href <url>       what the headline links to (http(s):// or a path on the hub)
  --note <text>      one line under the numbers; **bold**, \`code\` and [text](url) are rendered
  --item <spec>      a row: "label=count", "label=count:tone", repeatable (max 8)
  --ttl <minutes>    after this the reading is shown as outdated (default: never)
  --json <file|->    read the whole value as JSON instead (stdin is the default when piped)

A panel may also TAKE a value — fields in the sidebar (max 6 per panel):
  --control <spec>   "key=value:type:extra", repeatable. Types:
                       number   extra is a range, "0..6"
                       select   extra is the choices, "stunde|woche|monat"
                       toggle   value 1 or 0
                       text     extra is a placeholder
                       button   extra is nothing; the value is unused
                     Or a whole JSON object: --control '{"key":"n","type":"number",…}'
  --store <keys>     comma-separated controls the HUB keeps; read them back with
                     "fl-panel get". Without a --store and without a command,
                     the controls would do nothing and the push is refused.
  --action-cwd <dir> the directory the command runs in — REQUIRED for a command,
                     no default: it must be a checkout that is kept current
  --action-timeout <s>  how long it may run (default 60, max 600)
  -- <argv…>         everything after "--" is the command, as separate words.
                     "{{key}}" inside a word becomes that control's value.

The JSON shape (every field optional except one of total/items/controls):
  {"title":"Findings","total":33,"tone":"yellow","href":"https://…","note":"…",
   "items":[{"label":"bug","count":17,"tone":"red"},{"label":"task","count":16}],
   "controls":[{"key":"n","type":"number","label":"at once","value":1,"min":0,"max":6},
               {"key":"go","type":"button","label":"Apply"}],
   "action":{"cwd":"/path/to/a/current/checkout","argv":["./tool","--n","{{n}}"],"timeout_s":60}}
`

const args = process.argv.slice(2)
if (!args.length || args[0] === '-h' || args[0] === '--help') {
  process.stdout.write(USAGE)
  process.exit(args.length ? 0 : 2)
}

function die(msg, code = 2) {
  process.stderr.write(`fl-panel: ${msg}\n`)
  process.exit(code)
}

/**
 * Where the hub is.
 *
 * The order is the same one the installed skills use, and for the same reason:
 * inside a run `FL_HUB_URL` is authoritative, because it is the hub that
 * started this very run. Only then the operator's own env file, and only then
 * the code default.
 */
function hubBase() {
  const named = process.env.FL_HUB_URL || process.env.CC_HUB_URL || process.env.FREILAUF_HUB_URL
  if (named) return named.replace(/\/+$/, '')
  let port = process.env.FREILAUF_LOCAL_PORT || process.env.CCHUB_LOCAL_PORT
  if (!port) {
    for (const name of ['freilauf', 'cc-hub']) {
      const file = join(process.env.XDG_CONFIG_HOME || join(homedir(), '.config'), name, 'env')
      if (!existsSync(file)) continue
      const m = readFileSync(file, 'utf8').match(/^\s*(?:export\s+)?(?:FREILAUF|CCHUB)_LOCAL_PORT\s*=\s*"?(\d+)"?/m)
      if (m) { port = m[1]; break }
    }
  }
  return `http://127.0.0.1:${port || 8791}`
}

async function post(fields) {
  const body = new URLSearchParams()
  for (const [k, v] of Object.entries(fields)) if (v !== null && v !== undefined) body.set(k, String(v))
  const url = `${hubBase()}/api/panels`
  let res
  try {
    res = await fetch(url, {
      method: 'POST',
      headers: { 'content-type': 'application/x-www-form-urlencoded', accept: 'application/json' },
      body,
      signal: AbortSignal.timeout(15_000),
    })
  } catch (err) {
    die(`the hub at ${url} did not answer (${err.message}). Is it running? \`freilauf status\` says.`, 1)
  }
  let data = null
  try { data = await res.json() } catch { data = null }
  if (!res.ok || !data?.ok) die(data?.error ?? `HTTP ${res.status}`, 1)
  return data
}

async function readStdin() {
  const chunks = []
  for await (const c of process.stdin) chunks.push(c)
  return Buffer.concat(chunks).toString('utf8')
}

/** "label=count" or "label=count:tone" — the shorthand for a row. */
function parseItem(spec) {
  const m = String(spec).match(/^([^=]+)=([^:]*)(?::(\w+))?$/)
  if (!m) die(`--item "${spec}" is not "label=count" or "label=count:tone"`)
  const count = m[2].trim()
  return { label: m[1].trim(), count: count === '' ? null : Number(count), tone: m[3] ?? null }
}

/**
 * A control, in the same spirit as `--item`: "key=value:type:extra".
 *
 * The compact form covers what one types by hand; anything past it — a label
 * that is not the key, a hint, a confirmation, a step — is the JSON object,
 * which is what a script writes anyway. Two grammars and no middle one:
 * a spec language that grows a field a month is the thing this whole change is
 * meant to avoid.
 */
function parseControl(spec) {
  const raw = String(spec).trim()
  if (raw.startsWith('{')) {
    try { return JSON.parse(raw) } catch (err) { die(`--control: not valid JSON (${err.message})`) }
  }
  const m = raw.match(/^([a-z0-9][a-z0-9_-]*)(?:=([^:]*))?(?::([a-z]+))?(?::(.*))?$/i)
  if (!m) die(`--control "${spec}" is not "key=value:type:extra" and not a JSON object`)
  const [, key, value, type = 'text', extra] = m
  const c = { key, type }
  if (value !== undefined && value !== '') c.value = value
  if (type === 'number') {
    if (extra) {
      const r = extra.match(/^(-?[\d.]*)\.\.(-?[\d.]*)$/)
      if (!r) die(`--control "${spec}": a number's extra is a range like "0..6"`)
      if (r[1] !== '') c.min = Number(r[1])
      if (r[2] !== '') c.max = Number(r[2])
    }
  } else if (type === 'select') {
    if (!extra) die(`--control "${spec}": a select needs its choices, "a|b|c"`)
    c.options = extra.split('|').map(s => s.trim()).filter(Boolean)
  } else if (type === 'text') {
    if (extra) c.placeholder = extra
  } else if (extra) {
    die(`--control "${spec}": a ${type} takes no extra`)
  }
  return c
}

const cmd = args[0]
let rest = args.slice(1)
// Everything after a bare `--` is the command, word for word. The shell idiom
// rather than a `--arg` repeated eight times, and the reason there is no
// `--command "…"`: a command line assembled out of typed-in values must never
// pass through a shell, so it never exists as one string at any point.
let argv = null
const sep = rest.indexOf('--')
if (sep >= 0) { argv = rest.slice(sep + 1); rest = rest.slice(0, sep) }
const opt = {
  repo: null, title: null, total: null, tone: null, href: null, note: null, ttl: null, json: null,
  store: null, 'action-cwd': null, 'action-timeout': null, action: null,
}
const items = []
const controls = []
const words = []
for (let i = 0; i < rest.length; i++) {
  const a = rest[i]
  if (a === '--item') items.push(parseItem(rest[++i]))
  else if (a === '--control') controls.push(parseControl(rest[++i]))
  else if (a.startsWith('--') && Object.hasOwn(opt, a.slice(2))) opt[a.slice(2)] = rest[++i]
  else if (a.startsWith('--')) die(`unknown option ${a}`)
  else words.push(a)
}

const runId = process.env.FL_RUN_ID || process.env.CC_RUN_ID

/**
 * Which repo to READ from.
 *
 * A push says `run=<id>` and lets the hub work it out, but a read is a plain
 * GET with a repo id in it — so inside a run the id has to be fetched once.
 * That is what makes `fl-panel get` work with no arguments in the place it
 * matters most: a run of the very project whose setting it wants.
 */
async function readRepo() {
  if (opt.repo) return opt.repo
  if (runId) {
    const r = await fetch(`${hubBase()}/api/runs/${encodeURIComponent(runId)}`, { headers: { accept: 'application/json' } }).catch(() => null)
    const d = r ? await r.json().catch(() => null) : null
    if (d?.run?.repo_id) return String(d.run.repo_id)
  }
  die('name the repository: --repo <id> (`fl-api /api/repos` lists them)')
}

async function panelsOf(repo, key = null) {
  const url = `${hubBase()}/api/panels?repo=${encodeURIComponent(repo)}${key ? `&panel=${encodeURIComponent(key)}` : ''}`
  const res = await fetch(url, { headers: { accept: 'application/json' } }).catch(() => null)
  if (!res) die(`the hub at ${url} did not answer`, 1)
  const data = await res.json().catch(() => null)
  if (!data?.ok) die(data?.error ?? `HTTP ${res.status}`, 1)
  return data.panels
}

if (cmd === 'show') {
  const panels = await panelsOf(await readRepo())
  if (!panels.length) { process.stdout.write('no panels for this repo\n'); process.exit(0) }
  for (const p of panels) {
    process.stdout.write(`${p.key} — ${p.title} · ${p.total ?? '–'} · ${p.state} · ${p.at}\n`)
    for (const it of p.items) process.stdout.write(`    ${String(it.count ?? '–').padStart(6)}  ${it.label}${it.tone ? ` (${it.tone})` : ''}\n`)
    for (const c of p.controls ?? []) {
      if (c.type === 'button') { process.stdout.write(`    [${c.label}]\n`); continue }
      process.stdout.write(`    ${c.key} = ${JSON.stringify(c.value)}${c.stored ? ' (kept by the hub)' : ''}\n`)
    }
    if (p.action_state) process.stdout.write(`    last command: ${p.action_state}\n`)
    if (p.error) process.stdout.write(`    ! ${p.error}\n`)
  }
  process.exit(0)
}

// What a control is set to — the reading half of "the hub keeps the value".
// Bare values on stdout, one per line, so a script can do `n=$(fl-panel get
// schwarm gleichzeitig)` without a JSON parser anywhere near it.
if (cmd === 'get') {
  const key = words[0]
  if (!key) die('get needs a panel key')
  const panels = await panelsOf(await readRepo(), key)
  const panel = panels.find(p => p.key === key)
  if (!panel) die(`no panel "${key}" in this repo`, 1)
  const controls = (panel.controls ?? []).filter(c => c.type !== 'button')
  if (words[1]) {
    const c = controls.find(x => x.key === words[1])
    if (!c) die(`panel "${key}" has no control "${words[1]}" (it has: ${controls.map(x => x.key).join(', ') || 'none'})`, 1)
    process.stdout.write(`${c.value}\n`)
    process.exit(0)
  }
  for (const c of controls) process.stdout.write(`${c.key}=${c.value}\n`)
  process.exit(0)
}

const key = words[0]
if (!key) die(`"${cmd}" needs a panel key`)

if (cmd === 'clear') {
  await post({ key, repo: opt.repo, run: runId, remove: '1' })
  process.stdout.write(`fl-panel: ${key} removed\n`)
  process.exit(0)
}

if (cmd === 'error') {
  const message = words.slice(1).join(' ')
  if (!message) die('error needs a message')
  await post({ key, repo: opt.repo, run: runId, error: message })
  process.stdout.write(`fl-panel: ${key} marked as failed\n`)
  process.exit(0)
}

if (cmd !== 'set') die(`unknown command "${cmd}"`)

// The value: explicit JSON wins, then a pipe, then the --total/--item shorthand.
// A pipe is the ordinary case (`… --json | fl-panel set findings`), so it is
// read whenever stdin is not a terminal and no shorthand was given.
let value = null
const wantsStdin = opt.json === '-'
  || (!opt.json && !items.length && !controls.length && opt.total === null && !process.stdin.isTTY)
if (opt.json && opt.json !== '-') {
  try { value = JSON.parse(readFileSync(opt.json, 'utf8')) } catch (err) { die(`${opt.json}: ${err.message}`) }
} else if (wantsStdin) {
  const raw = (await readStdin()).trim()
  if (!raw) die('nothing on stdin — pipe JSON in, or use --total/--item')
  try { value = JSON.parse(raw) } catch (err) { die(`stdin is not valid JSON: ${err.message}`) }
} else {
  value = {}
}
if (typeof value !== 'object' || Array.isArray(value)) die('the value must be a JSON object')

// The flags are an OVERLAY on whatever came in as JSON, never a replacement:
// a producer prints the numbers, the caller names the block. That is what lets
// one counting script feed several panels without knowing about any of them.
if (opt.title) value.title = opt.title
if (opt.total !== null) value.total = Number(opt.total)
if (opt.tone) value.tone = opt.tone
if (opt.href) value.href = opt.href
if (opt.note) value.note = opt.note
if (items.length) value.items = [...(Array.isArray(value.items) ? value.items : []), ...items]
if (controls.length) value.controls = [...(Array.isArray(value.controls) ? value.controls : []), ...controls]
if (!value.title) value.title = key

// `--store a,b` marks controls the HUB keeps. A flag rather than a field per
// control because it is one decision about the panel — "who owns these values"
// — and spelling it once is how it stays one decision.
if (opt.store) {
  const keep = new Set(String(opt.store).split(',').map(s => s.trim()).filter(Boolean))
  const known = new Set((value.controls ?? []).map(c => c?.key))
  for (const k of keep) if (!known.has(k)) die(`--store names "${k}", which is not one of this panel's controls`)
  for (const c of value.controls ?? []) if (keep.has(c?.key)) c.store = true
}

// The command. `--` gave the argv; `--action-cwd` the directory, and it is
// required rather than defaulted on purpose — see docs/panels.md.
if (argv?.length) {
  if (!opt['action-cwd']) die('a command needs --action-cwd <dir>: the directory it runs in, spelled out')
  value.action = { cwd: opt['action-cwd'], argv }
  if (opt['action-timeout']) value.action.timeout_s = Number(opt['action-timeout'])
} else if (opt['action-cwd'] && !value.action) {
  die('--action-cwd was given but no command — everything after "--" is the command')
}

const r = await post({
  key,
  repo: opt.repo,
  run: runId,
  value: JSON.stringify(value),
  ttl: opt.ttl,
})
const n = r.panel?.items?.length ?? 0
const c = r.panel?.controls?.length ?? 0
process.stdout.write(`fl-panel: ${key} = ${r.panel?.total ?? '–'} (${n} row${n === 1 ? '' : 's'}${
  c ? `, ${c} control${c === 1 ? '' : 's'}` : ''})\n`)
for (const p of r.problems ?? []) process.stderr.write(`fl-panel: ${p}\n`)
process.exit(0)
