#!/usr/bin/env bash
# cc-report — agents report back to cc-hub (Planung 6).
# Usage:
#   cc-report done [--file report.md | "text"]     Run completed
#   cc-report failed "reason"                      Run failed
#   cc-report help "question/problem"              Call for help (run stays open, waits)
#   cc-report progress "status"                    Progress / taking longer
#   cc-report branch <name>                        Branch reported
#   cc-report pr <url>                             Pull request reported
#   cc-report _api_error [error] ["text"]         Rate-limit/provider error (from hooks);
#                                                  without arguments: Claude hook JSON on stdin
#   cc-report _turn_end|_exit|_rate_limit|_idle|_pane_died [exit]   internal hooks
#
# Source: CC_RUN_ID + CC_HUB_URL from the environment. Fallback when the hub is not
# reachable: JSON line to ~/agents/runs/<id>/inbox.jsonl — the watcher collects it.
set -euo pipefail

usage() {
    sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
}

[[ $# -ge 1 ]] || { usage >&2; exit 2; }
KIND="$1"; shift

case "$KIND" in
    done|failed|help|progress|branch|pr) ;;
    _turn_end|_exit|_rate_limit|_idle|_pane_died|_api_error) ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'unknown kind: %s\n' "$KIND" >&2; exit 2 ;;
esac

RUN_ID="${CC_RUN_ID:-}"
HUB="${CC_HUB_URL:-http://127.0.0.1:8791}"
if [[ -z "$RUN_ID" ]]; then
    echo "cc-report: CC_RUN_ID is not set — pointless outside a cc-hub run." >&2
    exit 3
fi

TEXT="" ; FILE_ARG="" ; ERR="" ; SESSION_ID=""
# Claude calls the StopFailure hook without arguments and delivers the event as JSON
# on stdin: { "error": "rate_limit", "last_assistant_message": "…", "session_id": "…" }.
# The other hook kinds (Stop, SessionEnd, Notification) get the same JSON shape.
# session_id is forwarded so the hub can tell the run's OWN session from a claude
# process the agent spawned (which inherits hooks and CC_RUN_ID but carries its own
# session id) — its failures must not land on the run as incidents.
if [[ "$KIND" == "_api_error" || "$KIND" == "_turn_end" || "$KIND" == "_exit" || "$KIND" == "_idle" ]]; then
    HOOK_JSON=""
    if [[ "$KIND" == "_api_error" ]]; then
        if [[ -n "${1:-}" ]]; then
            ERR="$1"; shift; TEXT="${*:-}"
        elif [[ ! -t 0 ]]; then
            HOOK_JSON="$(cat 2>/dev/null || true)"
        else
            ERR="unknown"
        fi
    elif [[ ! -t 0 ]]; then
        HOOK_JSON="$(cat 2>/dev/null || true)"
    fi
    if [[ -n "$HOOK_JSON" ]]; then
        ERR="$(printf '%s' "$HOOK_JSON" | python3 -c 'import json,sys
try: j=json.load(sys.stdin); print(j.get("error") or "unknown")
except Exception: print("unknown")' 2>/dev/null || echo unknown)"
        TEXT="$(printf '%s' "$HOOK_JSON" | python3 -c 'import json,sys
try: j=json.load(sys.stdin); print((j.get("last_assistant_message") or j.get("error_details") or "")[:300])
except Exception: pass' 2>/dev/null || true)"
        SESSION_ID="$(printf '%s' "$HOOK_JSON" | python3 -c 'import json,sys
try: j=json.load(sys.stdin); print(j.get("session_id") or "")
except Exception: pass' 2>/dev/null || true)"
    fi
    if [[ "$KIND" == "_api_error" ]]; then set --; fi
fi
if [[ -n "${1:-}" ]]; then
    if [[ "$KIND" == "done" && "${1:-}" == "--file" ]]; then
        FILE_ARG="${2:-}"
        [[ -r "$FILE_ARG" ]] || { echo "Report file not readable: $FILE_ARG" >&2; exit 2; }
    else
        TEXT="$*"
    fi
fi

# Build the payload as JSON with python3 (quoting-safe, no jq dependency).
PAYLOAD="$(python3 - "$KIND" "$TEXT" "$FILE_ARG" "$ERR" "$SESSION_ID" <<'PY'
import json, sys
kind, text, file_arg, err, session_id = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5]
body = {"kind": kind}
if kind == "_api_error":
    body["error"] = err or "unknown"
    if text:
        body["text"] = text
elif kind == "_pane_died" and text.isdigit():
    body["exit"] = int(text)
elif kind == "branch":
    body["branch"] = text
elif kind == "pr":
    body["pr"] = text
else:
    if file_arg and os.path.isfile(file_arg):
        with open(file_arg, encoding="utf-8", errors="replace") as fh:
            body["file"] = fh.read()
    elif text:
        body["text"] = text
if session_id:
    body["session_id"] = session_id
print(json.dumps(body))
PY
)"

send() {
    curl -fsS --max-time 10 -X POST \
         -H 'content-type: application/json' \
         --data-binary "$PAYLOAD" \
         "$HUB/api/runs/$RUN_ID/report"
}

FALLBACK_DIR="$HOME/agents/runs/$RUN_ID"
if OUT="$(send 2>/dev/null)"; then
    # cc-hub may ANSWER a report instead of just accepting it: with the repo's
    # integration switched on, `done` is checked (worktree clean? branch still
    # mergeable?) and the answer says what is still missing. Printing it puts the
    # text into the agent's running turn as this tool's own output — the cheapest
    # possible moment to tell it. Silent otherwise, as before.
    printf '%s' "$OUT" | python3 -c 'import json,sys
try:
    j = json.load(sys.stdin)
    m = j.get("message")
    if m: print(m)
except Exception:
    pass' 2>/dev/null || true
    exit 0
fi

# Fallback: hub not reachable → inbox.jsonl (the watcher collects it, Planung 6).
mkdir -p "$FALLBACK_DIR" 2>/dev/null || true
printf '%s\n' "$PAYLOAD" >> "$FALLBACK_DIR/inbox.jsonl"
echo "cc-report: hub not reachable — the report is in inbox.jsonl, the watcher will pick it up." >&2
exit 0
