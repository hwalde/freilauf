#!/usr/bin/env bash
# Lists running coding-agent sessions (claude/opencode/hermes), attaches to one of
# them, and can optionally type a prompt into the running session.
# Usage: cc-attach [options] [session-name]
set -euo pipefail

PREFIX="cc-"

usage() {
    cat <<'EOF'
Usage: cc-attach [options] [session-name]

  session-name   Pick a session directly (with or without the cc-/cc-oc-/cc-he- prefix).
                 If omitted: selection list (or directly, if only one is running).

Options:
  -H, --harness HARNESS   Only show/address sessions of this harness:
                          claude | opencode | hermes
  -p, --prompt TEXT     Type this prompt into the chosen session and submit it,
                        then attach.
  -f, --prompt-file FILE Read the prompt from a file (instead of -p).
  -n, --no-attach       Only send the prompt, do not attach (for scripts/cron).
  -h, --help            Overview of all cc commands.

Examples:
  cc-attach                                  # pick a session and connect
  cc-attach -H opencode                      # list opencode sessions only
  cc-attach leadmachine                      # connect directly (any harness)
  cc-attach -p "Status?" nightrun            # send a question in and watch
  cc-attach -p "Continue" -n nightrun        # send only, do not attach

Note: the permission mode of a RUNNING session can no longer be changed.
Autonomous (no questions asked) is started with:  cc-start -p "..." [name] [directory]
EOF
}

err() { printf '%s\n' "$*" >&2; }

PROMPT=""
PROMPT_FILE=""
NO_ATTACH=""
TARGET=""
HARNESS=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)        exec cc-help ;;
        --usage)          usage; exit 0 ;;
        -H|--harness)     [[ $# -ge 2 ]] || { err "Error: $1 requires a value."; exit 2; }
                          HARNESS="$2"; shift 2 ;;
        -p|--prompt)      [[ $# -ge 2 ]] || { err "Error: $1 requires a text."; exit 2; }
                          PROMPT="$2"; shift 2 ;;
        -f|--prompt-file) [[ $# -ge 2 ]] || { err "Error: $1 requires a file path."; exit 2; }
                          PROMPT_FILE="$2"; shift 2 ;;
        -n|--no-attach)   NO_ATTACH=1; shift ;;
        --)               shift; TARGET="${1:-}"; break ;;
        -*)               err "Unknown option: $1  (cc-attach --usage)"; exit 2 ;;
        *)                TARGET="$1"; shift ;;
    esac
done

if [[ -n "$HARNESS" ]]; then
    case "$HARNESS" in
        claude|opencode|hermes) ;;
        *) err "Error: unknown harness '$HARNESS'. Allowed: claude opencode hermes"; exit 2 ;;
    esac
fi

if [[ -n "$PROMPT_FILE" ]]; then
    [[ -n "$PROMPT" ]] && { err "Error: -p and -f are mutually exclusive."; exit 2; }
    [[ -r "$PROMPT_FILE" ]] || { err "Error: prompt file not readable: $PROMPT_FILE"; exit 2; }
    PROMPT="$(cat "$PROMPT_FILE")"
fi
if [[ -n "$NO_ATTACH" && -z "$PROMPT" ]]; then
    err "Error: --no-attach without a prompt does nothing."; exit 2
fi

# Derive a session's harness from its name: cc-oc-* -> opencode, cc-he-* -> hermes, else claude.
harness_of() {
    case "$1" in
        "$PREFIX"oc-*) echo "opencode" ;;
        "$PREFIX"he-*) echo "hermes" ;;
        *) echo "claude" ;;
    esac
}

mapfile -t ROWS < <(tmux list-sessions \
    -F '#{session_name}|#{t:session_created}|#{?session_attached,attached,free}|#{session_path}' \
    2>/dev/null | grep "^$PREFIX" || true)

SESSIONS=()
for row in "${ROWS[@]}"; do
    s="${row%%|*}"
    [[ -n "$HARNESS" ]] && [[ "$(harness_of "$s")" != "$HARNESS" ]] && continue
    SESSIONS+=("$s")
done

if [[ ${#SESSIONS[@]} -eq 0 ]]; then
    if [[ -n "$HARNESS" ]]; then
        echo "No running $HARNESS session found."
    else
        echo "No running agent session found."
    fi
    echo "Start a new session with: cc-start [-H claude|opencode|hermes] [-p \"prompt\"] [name] [directory]"
    exit 1
fi

# Type the prompt into the running session. Multi-line via bracketed paste (Planung §9):
# the TUI takes the text as a single paste without per-line Enter; the final Enter only
# submits AFTER the paste (300 ms pause, otherwise the Enter gets swallowed).
send_prompt() {
    local s="$1" text
    [[ -n "${PROMPT//[[:space:]]/}" ]] || { err "Error: prompt is empty."; exit 2; }
    text="$PROMPT"
    if tmux send-keys -t "$s:" -l -- $'\e[200~'"$text"$'\e[201~' 2>/dev/null; then
        sleep 0.3
        tmux send-keys -t "$s:" Enter
    else
        # Fallback (TUI without bracketed-paste support): flatten as before.
        text="$(printf '%s' "$text" | tr '\n\r' '  ')"
        tmux send-keys -t "$s:" -l -- "$text"
        sleep 0.4
        tmux send-keys -t "$s:" Enter
    fi
    echo "Prompt sent to '$s' (${#text} characters)."
}

finish() {
    local s="$1"
    [[ -n "$PROMPT" ]] && send_prompt "$s"
    if [[ -n "$NO_ATTACH" ]]; then
        exit 0
    fi
    echo "Connecting to '$s' ... (detach: Ctrl+b, then d)"
    if [[ -n "${TMUX:-}" ]]; then
        tmux switch-client -t "=$s"
    else
        tmux attach-session -t "=$s"
    fi
}

# Direct selection via argument (with or without prefix/harness tag)
if [[ -n "$TARGET" ]]; then
    for s in "${SESSIONS[@]}"; do
        bare="${s#$PREFIX}"               # remove cc-
        bare="${bare#oc-}"; bare="${bare#he-}"   # remove the harness tag
        if [[ "$s" == "$TARGET" || "$s" == "$PREFIX$TARGET" || "$bare" == "$TARGET" ]]; then
            finish "$s"
            exit 0
        fi
    done
    err "Error: session '$TARGET' not found."
    exit 1
fi

# Exactly one session -> go directly
if [[ ${#SESSIONS[@]} -eq 1 ]]; then
    finish "${SESSIONS[0]}"
    exit 0
fi

echo "Running agent sessions:"
echo
i=1
for row in "${ROWS[@]}"; do
    IFS='|' read -r name created attached path <<<"$row"
    [[ -n "$HARNESS" ]] && [[ "$(harness_of "$name")" != "$HARNESS" ]] && continue
    printf "  [%d] %-24s  (%s)  started: %s  (%s)\n" "$i" "$name" "$(harness_of "$name")" "$created" "$attached"
    printf "      %s\n" "$path"
    i=$((i + 1))
done
echo

read -r -p "Which session? [1-$((i - 1)), q=cancel]: " choice
[[ "$choice" == "q" || -z "$choice" ]] && { echo "Cancelled."; exit 0; }

if ! [[ "$choice" =~ ^[0-9]+$ ]] || (( choice < 1 || choice > i - 1 )); then
    err "Invalid selection."
    exit 1
fi

finish "${SESSIONS[choice - 1]}"
