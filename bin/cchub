#!/usr/bin/env bash
# cchub — controls the cc-hub. Planung 4.8 + 9.
#   cchub on|off|status|url|logs|restart|stop|start
#   cchub deploy [ref]
#   cchub pipeline on|off|status
set -euo pipefail

ENV_FILE="$HOME/.config/cc-hub/env"
[[ -f "$ENV_FILE" ]] && . "$ENV_FILE"
LOCAL_PORT="${CCHUB_LOCAL_PORT:-8791}"
VPN_PORT="${CCHUB_VPN_PORT:-8790}"
VPN_BIND="${CCHUB_VPN_BIND:-<VPN IP not set>}"

usage() {
    cat <<'EOF'
Usage: cchub <command>

  on            start the VPN proxy  → website reachable from outside (WireGuard)
  off           stop the VPN proxy   → website local-only again (fail-closed)
  status        state of all three switches + processes
  url           print the VPN URL
  logs          journalctl --user -u cchub -f
  start|stop|restart   control the hub process (scheduler/watcher/UI)

  deploy [ref]  bring a commit live: fetch, check out in the hub's own deploy
                checkout, dependencies, scripts, restart, health check —
                and roll back if the hub does not come up (cchub-deploy)

  pipeline on|off|status   global AND gate for scheduled agent starts

Switch model: access (VPN proxy) · pipeline (scheduler gate) · agent (active flag
in the UI). Hub, scheduler, watcher, notifications and running agents keep running
independently of the access switch.
EOF
}

db_pipeline() {
    node --disable-warning=ExperimentalWarning -e '
const {DatabaseSync}=require("node:sqlite");
const {join}=require("node:path");
const db=new DatabaseSync(join(process.env.HOME,".local/share/cc-hub/cc-hub.db"));
const r=db.prepare("SELECT value FROM settings WHERE key=?").get("pipeline_on");
process.stdout.write((r&&r.value==="1")?"on":"off");' 2>/dev/null || echo '?'
}

set_pipeline() {
    node --disable-warning=ExperimentalWarning -e '
const {DatabaseSync}=require("node:sqlite");
const {join}=require("node:path");
const db=new DatabaseSync(join(process.env.HOME,".local/share/cc-hub/cc-hub.db"));
db.prepare("INSERT INTO settings(key,value) VALUES(?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value").run("pipeline_on", process.argv[1]);' "$1"
}

case "${1:-}" in
    on)
        systemctl --user start cchub-vpn.service
        echo "Access on: https://${VPN_BIND}:${VPN_PORT}"
        ;;
    off)
        systemctl --user stop cchub-vpn.service
        echo "Access off (hub keeps running locally)."
        ;;
    status)
        hub="$(systemctl --user is-active cchub.service 2>/dev/null || true)" ; hub="${hub:-unknown}"
        vpn="$(systemctl --user is-active cchub-vpn.service 2>/dev/null || true)"; vpn="${vpn:-unknown}"
        echo "Hub process:  $hub   (127.0.0.1:${LOCAL_PORT})"
        echo "Access (VPN): $vpn   (https://${VPN_BIND}:${VPN_PORT})"
        echo "Pipeline:     $(db_pipeline)"
        echo "Running cc sessions: $(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -c '^cc-' || true)"
        # Which commit is actually running, and whether origin has moved on. The
        # deploy script is the only thing that knows its checkout, so it answers.
        if command -v cchub-deploy >/dev/null 2>&1; then
            cchub-deploy --status 2>/dev/null | grep -E '^(Deployed|Ahead):' || true
        fi
        ;;
    deploy)
        shift
        command -v cchub-deploy >/dev/null 2>&1 || {
            echo "cchub-deploy is not installed — run ./setup/02-install-scripts.sh" >&2; exit 2; }
        exec cchub-deploy "$@"
        ;;
    url)
        echo "https://${VPN_BIND}:${VPN_PORT}"
        ;;
    logs)
        exec journalctl --user -u cchub -f -n 100
        ;;
    start)
        systemctl --user start cchub.service ;;
    stop)
        systemctl --user stop cchub.service ;;
    restart)
        systemctl --user restart cchub.service ;;
    pipeline)
        case "${2:-status}" in
            on)  set_pipeline 1; echo "Pipeline on." ;;
            off) set_pipeline 0; echo "Pipeline off — agent flags remain unchanged." ;;
            status) echo "Pipeline: $(db_pipeline)" ;;
            *) usage; exit 2 ;;
        esac ;;
    -h|--help|"" ) usage ;;
    *) usage; exit 2 ;;
esac
