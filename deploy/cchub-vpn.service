# cc-hub VPN access (TLS on wg0). Fail-closed: NOT automatically active after reboot.
[Unit]
Description=cc-hub VPN access (TLS on wg0)
After=cchub.service
Requires=cchub.service

[Service]
Type=simple
EnvironmentFile=%h/.config/cc-hub/env
# Same checkout as the hub itself — see the comment in cchub.service.
WorkingDirectory=%h/agents/deploy/cc-hub
ExecStart=/usr/bin/node %h/agents/deploy/cc-hub/vpn-proxy.mjs
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
