# cc-hub Web-UI + Scheduler + Watcher (nur 127.0.0.1)
[Unit]
Description=cc-hub (Agenten-Verwaltung, nur 127.0.0.1)
After=network.target

[Service]
Type=simple
Environment=NODE_OPTIONS=--disable-warning=ExperimentalWarning
# systemd-User-Dienste starten mit einem minimalen PATH ohne ~/.local/bin. Ohne diese
# Zeile findet cc-start weder 'claude' noch 'opencode'/'hermes', und der Agent in der
# tmux-Session erbt denselben PATH — 'cc-report' wäre dort ebenfalls unauffindbar.
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=%h/.config/cc-hub/env
ExecStart=/usr/bin/node %h/projects/cc-hub/server/hub.mjs
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
