# Configuration for cc-hub — template.
# setup/03-install-services.sh copies this file to ~/.config/cc-hub/env
# if none exists there yet. Adjust the values there; afterwards: cchub restart
# IMPORTANT: systemd reads this file without shell expansion — do not use ~ or $HOME.

# Local port of the hub (binds to 127.0.0.1 only, never reachable from outside)
CCHUB_LOCAL_PORT=8791

# Port of the VPN side — this is where the browser connects
CCHUB_VPN_PORT=8790

# Address the VPN proxy binds to: the machine's own WireGuard address.
# REQUIRED for the proxy — without a value it does not start (deliberately no
# default: this service must never end up on 0.0.0.0).
#CCHUB_VPN_BIND=

# Authorities under which the proxy may be addressed (DNS rebinding protection).
# Only things an attacker cannot bring about may be listed here: the VPN IP, or a
# name whose DNS you control yourself. Every name must also appear in the certificate.
#CCHUB_ALLOWED_HOSTS=<vpn-ip>:8790,hub.example.internal:8790

# Certificate directory containing dev-cert.pem + dev-key.pem (e.g. from mkcert).
# Default in the code: ~/.local/certs/cc-hub — override here only with an ABSOLUTE path.
#CCHUB_CERT_DIR=

# Provider keys for opencode/hermes. The hub passes them into the agent session via
# 'cc-start --env' — tmux does NOT inherit the environment; without these lines a run
# starts and only dies on its first API call. The model LISTS in the form do not
# need a key.
#OPENROUTER_API_KEY=
#DEEPSEEK_API_KEY=
#OPENCODE_API_KEY=

# Public base URL for the links in Telegram messages (hostname instead of IP, so the
# link in the browser matches the certificate). Without a value, buttons point nowhere.
#CCHUB_PUBLIC_URL=https://hub.example.internal:8790
