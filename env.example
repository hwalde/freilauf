# Konfiguration für cc-hub — Vorlage.
# setup/03-install-services.sh kopiert diese Datei nach ~/.config/cc-hub/env,
# falls dort noch keine liegt. Werte dort anpassen; danach: cchub restart
# WICHTIG: systemd liest die Datei ohne Shell-Expansion — keine ~ oder $HOME verwenden.

# Lokaler Port des Hubs (bindet nur an 127.0.0.1, nie von außen erreichbar)
CCHUB_LOCAL_PORT=8791

# Port der VPN-Seite — hier verbindet sich der Browser hin
CCHUB_VPN_PORT=8790

# Adresse, an die der VPN-Proxy bindet: die eigene WireGuard-Adresse.
# PFLICHT für den Proxy — ohne Wert startet er nicht (absichtlich kein Default:
# an 0.0.0.0 darf dieser Dienst nie geraten).
#CCHUB_VPN_BIND=

# Authorities, unter denen der Proxy angesprochen werden darf (DNS-Rebinding-Schutz).
# Hier darf nur stehen, was ein Angreifer nicht herbeiführen kann: die VPN-IP oder
# ein Name, dessen DNS einem selbst gehört. Jeder Name muss auch im Zertifikat stehen.
#CCHUB_ALLOWED_HOSTS=<vpn-ip>:8790,hub.example.internal:8790

# Zertifikatsordner mit dev-cert.pem + dev-key.pem (z. B. von mkcert).
# Default im Code: ~/.local/certs/cc-hub — hier nur mit ABSOLUTEM Pfad überschreiben.
#CCHUB_CERT_DIR=

# Provider-Keys für opencode/hermes. Der Hub reicht sie per 'cc-start --env' in die
# Agenten-Session weiter — tmux vererbt die Umgebung NICHT, ohne diese Zeilen startet
# ein Lauf und stirbt erst beim ersten API-Aufruf. Die Modell-LISTEN im Formular
# brauchen keinen Key.
#OPENROUTER_API_KEY=
#DEEPSEEK_API_KEY=
#OPENCODE_API_KEY=

# Öffentliche Basis-URL für die Links in Telegram-Nachrichten (Hostname statt IP,
# damit der Link im Browser zum Zertifikat passt). Ohne Wert zeigen Buttons ins Leere.
#CCHUB_PUBLIC_URL=https://hub.example.internal:8790
