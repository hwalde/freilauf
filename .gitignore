node_modules
.playwright-mcp/

# bin/freilauf-deploy's bookkeeping in the deploy checkout: the hash of the
# package-lock.json the current node_modules was installed from. It lives next to
# node_modules and must survive the `git clean` of a deploy — but it belongs to no
# commit.
.deploy-lock-hash

# Privat — versioniert im Schwester-Repo cc-hub-private
PLANUNG.md
CLAUDE.local.md
opencode.json

# Nie committen
*.db
.env
*.pem
*.key

# Local Claude Code state (never commit)
.claude/settings.local.json

# Written by the hub into every cursor worktree (the 'stop' hook that reports
# the end of a turn) — ours, not the agent's work. Only this one file: a repo's
# own .cursor/rules are perfectly checkinable.
.cursor/hooks.json

# Unlazy work-tree tracking artifacts (machine-specific)
.unlazy/
